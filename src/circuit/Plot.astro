---
/*
 * Static chart, computed when the site is built (no JavaScript on the page):
 * a circuit simulated until `until` seconds showing `series`, or fixed `data`.
 * Text stays readable at any width: the curves stretch, the labels are HTML.
 */
import { SERIES_COLORS } from './colors';
import { formatSI } from './format';
import { BOX, clean, layoutPlot } from './plot/layout';
import { simulateForPlot, type PlotData } from './plot/run';
import { loadCircuit } from './registry';

export interface PlotSeries {
  label: string;
  unit?: string;
  points: [number, number][];
}

export interface Props {
  /** Chart of a simulation run until `until` seconds… */
  circuit?: string;
  until?: number;
  /** …showing these readouts ("R1.current", "C1.voltage") or probe ids. */
  series?: string[];
  /** Or a chart of fixed points. */
  data?: PlotSeries[];
  /** Unit of the horizontal axis for `data` (default "s"). */
  xUnit?: string;
  title?: string;
  height?: number;
}

const { circuit, until = 1, series, data, xUnit = 's', title, height = 280 } = Astro.props;

let plot: PlotData;
if (data) {
  plot = {
    xUnit,
    log: false,
    series: data.map((s) => ({ label: s.label, unit: s.unit ?? '', points: s.points })),
  };
} else if (circuit) {
  const doc = await loadCircuit(circuit);
  const keys = series ?? (doc.probes ?? []).map((p) => p.id);
  plot = await simulateForPlot(doc, until, keys);
} else {
  throw new Error('<Plot> precisa de "circuit" (com "until" e "series") ou de "data".');
}

const layout = layoutPlot(plot.series, plot);
const right = layout.axes.length > 1;
const color = (i: number) => SERIES_COLORS[i % SERIES_COLORS.length];

// Text alternative: where each curve starts and ends, and its extremes.
const describe = plot.series
  .map((s) => {
    const ys = s.points.map((p) => clean(p[1])).filter(Number.isFinite);
    if (ys.length === 0) return `${s.label}: sem dados`;
    const f = (v: number) => formatSI(v, s.unit);
    return `${s.label}: começa em ${f(ys[0]!)}, termina em ${f(ys[ys.length - 1]!)}, mínimo ${f(Math.min(...ys))}, máximo ${f(Math.max(...ys))}`;
  })
  .join('; ');
const xRange = `${formatSI(layout.x.min, plot.xUnit)} a ${formatSI(layout.x.max, plot.xUnit)}`;
const label = `Gráfico${title ? ` de ${title}` : ''}, de ${xRange}. ${describe}.`;

// A few rows for the data table.
const rows = (() => {
  const base = plot.series[0]?.points ?? [];
  if (base.length === 0) return [];
  const n = Math.min(11, base.length);
  return Array.from({ length: n }, (_, k) =>
    Math.round((k * (base.length - 1)) / Math.max(n - 1, 1)),
  );
})();
---

<figure class="sim-plot breakout" data-plot={circuit ?? 'dados'}>
  {title && <figcaption class="sim-plot__title">Gráfico: {title}</figcaption>}
  <ul class="sim-plot__legend" aria-hidden="true">
    {layout.series.map((s) => (
      <li>
        <span class="sim-plot__swatch" style={`background: ${color(s.color)}`} />
        {s.label}
        {s.unit && <span class="sim-plot__unit"> ({s.unit})</span>}
        {s.axis === 1 && <span class="sim-plot__unit"> · tracejada, eixo da direita</span>}
      </li>
    ))}
  </ul>
  <div
    class:list={['sim-plot__frame', { 'has-right': right }]}
    style={`--plot-h: ${height}px`}
    role="img"
    aria-label={label}
  >
    <div class="sim-plot__y sim-plot__y--left" aria-hidden="true">
      {layout.axes[0]?.ticks.map((t) => (
        <span class="num" style={`top: ${(t.pos / BOX) * 100}%`}>
          {t.label}
        </span>
      ))}
    </div>
    <div class="sim-plot__area">
      <svg viewBox={`0 0 ${BOX} ${BOX}`} preserveAspectRatio="none" aria-hidden="true">
        {layout.x.ticks.map((t) => (
          <line x1={t.pos} x2={t.pos} y1="0" y2={BOX} class="sim-plot__grid" />
        ))}
        {layout.axes[0]?.ticks.map((t) => (
          <line x1="0" x2={BOX} y1={t.pos} y2={t.pos} class="sim-plot__grid" />
        ))}
        {layout.series.map((s) => (
          <path
            d={s.path}
            class:list={['sim-plot__line', { 'is-right': s.axis === 1 }]}
            style={`stroke: ${color(s.color)}`}
          />
        ))}
      </svg>
    </div>
    {right && (
      <div class="sim-plot__y sim-plot__y--right" aria-hidden="true">
        {layout.axes[1]!.ticks.map((t) => (
          <span class="num" style={`top: ${(t.pos / BOX) * 100}%`}>
            {t.label}
          </span>
        ))}
      </div>
    )}
    <div class="sim-plot__x" aria-hidden="true">
      {layout.x.ticks.map((t) => (
        <span class="num" style={`left: ${(t.pos / BOX) * 100}%`}>
          {t.label}
        </span>
      ))}
    </div>
  </div>
  {rows.length > 0 && (
    <details class="sim-plot__data">
      <summary>Ver os valores</summary>
      <div class="sim-plot__table">
        <table>
          <thead>
            <tr>
              <th scope="col">{plot.xUnit === 'Hz' ? 'Frequência' : 'Tempo'}</th>
              {plot.series.map((s) => (
                <th scope="col">{s.label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((i) => (
              <tr>
                <td class="num">{formatSI(plot.series[0]!.points[i]![0], plot.xUnit)}</td>
                {plot.series.map((s) => (
                  <td class="num">{formatSI(clean(s.points[i]?.[1] ?? Number.NaN), s.unit)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
</figure>

<style>
  .sim-plot {
    display: grid;
    gap: 0.5rem;
    margin: 1.75em 0;
    padding: 0.75rem 0.75rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .sim-plot__title {
    font-weight: 600;
  }

  .sim-plot__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
  }

  .sim-plot__legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
  }

  .sim-plot__swatch {
    width: 0.875rem;
    height: 0.1875rem;
    border-radius: 999px;
  }

  .sim-plot__unit {
    color: var(--fg-muted);
  }

  .sim-plot__frame {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: var(--plot-h) auto;
    column-gap: 0.5rem;
    padding: 0.5rem 0.25rem 0 0;
    color: var(--fg-muted);
    font-size: 0.75rem;
  }

  .sim-plot__frame.has-right {
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  .sim-plot__y {
    position: relative;
    min-width: 3.25rem;
  }

  .sim-plot__y span {
    position: absolute;
    right: 0;
    line-height: 1;
    white-space: nowrap;
    transform: translateY(-50%);
  }

  .sim-plot__y--right span {
    right: auto;
    left: 0;
  }

  .sim-plot__area {
    position: relative;
    border-left: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .has-right .sim-plot__area {
    border-right: 1px solid var(--border-strong);
  }

  .sim-plot__area svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .sim-plot__grid {
    stroke: var(--border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .sim-plot__line {
    fill: none;
    stroke-width: 2.25;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .sim-plot__line.is-right {
    stroke-dasharray: 6 4;
  }

  .sim-plot__x {
    position: relative;
    grid-column: 2;
    height: 1.5rem;
  }

  .sim-plot__x span {
    position: absolute;
    top: 0.35rem;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .sim-plot__x span:first-child {
    transform: none;
  }

  .sim-plot__x span:last-child {
    transform: translateX(-100%);
  }

  .sim-plot__data summary {
    width: fit-content;
    color: var(--fg-muted);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .sim-plot__table {
    overflow-x: auto;
  }

  .sim-plot__table table {
    width: 100%;
    margin: 0.375rem 0 0;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }

  .sim-plot__table th,
  .sim-plot__table td {
    padding: 0.25rem 0.5rem;
    border-bottom: 1px solid var(--border);
    text-align: right;
    white-space: nowrap;
  }
</style>
