---
/*
 * Progress of a set of lessons, filled in the browser (src/course/progress/ui.ts).
 * Lessons without a page yet don't count.
 */
import { countLabel } from '../progress/ui';

interface Props {
  /** Lesson ids that count (only lessons with a page). */
  lessons: string[];
  /** Accessible name of the bar: "Progresso no módulo". */
  label: string;
  /** `compact` shows only a thin bar and hides it while there is no progress. */
  variant?: 'full' | 'compact';
}

const { lessons, label, variant = 'full' } = Astro.props;
const text = countLabel(0, lessons.length);
---

<div
  class:list={['pbar', `pbar--${variant}`]}
  data-progress-of={lessons.join(' ')}
  data-progress-state="vazio"
  data-pagefind-ignore
>
  <div
    class="pbar__track"
    role="progressbar"
    aria-label={label}
    aria-valuemin="0"
    aria-valuemax={lessons.length}
    aria-valuenow="0"
    aria-valuetext={text}
    data-progress-meter
  >
    <span class="pbar__fill"></span>
  </div>
  {variant === 'full' && (
    <p class="pbar__text">
      <span data-progress-label>{text}</span>
      <span class="pbar__percent num" data-progress-percent>
        0%
      </span>
    </p>
  )}
</div>

<script>
  import { startProgressUi } from '../progress/ui';
  startProgressUi();
</script>

<style>
  .pbar {
    --progress: 0;
    display: grid;
    gap: 0.5rem;
  }

  .pbar__track {
    position: relative;
    height: 0.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: var(--surface-2);
  }

  .pbar__fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent), color-mix(in oklab, var(--accent) 70%, var(--copper)));
    transform: scaleX(var(--progress));
    transform-origin: left;
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pbar[data-progress-state='completo'] .pbar__fill {
    background: var(--success);
  }

  .pbar__text {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .pbar__percent {
    color: var(--fg);
    font-weight: 600;
  }

  .pbar--compact .pbar__track {
    height: 0.3rem;
  }

  .pbar--compact[data-progress-state='vazio'] {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .pbar__fill {
      transition: none;
    }
  }
</style>
