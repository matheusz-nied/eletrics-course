---
/*
 * Search field and results, used on /busca/ and in the header dialog.
 * The logic is in search-box.ts; several boxes can live on one page.
 */
import CourseIcon from '../ui/CourseIcon.astro';
import { withBase } from '../../lib/url';

interface Props {
  /** Unique on the page. */
  id: string;
  /** Focus the field when the page opens (the /busca/ page). */
  autofocus?: boolean;
  /** Keep the query in the address (?q=), on the /busca/ page. */
  syncUrl?: boolean;
}

const { id, autofocus = false, syncUrl = false } = Astro.props;
const filters = [
  { value: '', label: 'Tudo' },
  { value: 'Aula', label: 'Aulas' },
  { value: 'Glossário', label: 'Glossário' },
];
---

<div class="sbox" data-search-box data-sync-url={syncUrl ? '' : undefined}>
  <form class="sbox__form" role="search" action={withBase('busca/')} method="get">
    <label for={`${id}-q`} class="sr-only">Buscar no curso</label>
    <CourseIcon name="buscar" size={20} class="sbox__icon" />
    <input
      id={`${id}-q`}
      name="q"
      type="search"
      class="sbox__input"
      placeholder="Buscar aulas e termos: capacitor, disjuntor, fotocélula…"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
      autofocus={autofocus}
      aria-describedby={`${id}-status`}
      aria-controls={`${id}-results`}
      data-search-input
    />
  </form>
  <div class="sbox__filters" role="radiogroup" aria-label="Mostrar">
    {
      filters.map((f, i) => (
        <button
          type="button"
          role="radio"
          class="sbox__filter"
          aria-checked={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-search-filter={f.value}
        >
          {f.label}
        </button>
      ))
    }
  </div>
  <p id={`${id}-status`} class="sbox__status" aria-live="polite" data-search-status>
    Digite pelo menos duas letras.
  </p>
  <ol id={`${id}-results`} class="sbox__results" aria-label="Resultados" data-search-results></ol>
</div>

<script>
  import { initSearchBoxes } from './search-box';
  initSearchBoxes();
</script>

<style>
  .sbox {
    display: grid;
    gap: 0.875rem;
  }

  .sbox__form {
    position: relative;
  }

  .sbox :global(.sbox__icon) {
    position: absolute;
    top: 50%;
    left: 0.95rem;
    color: var(--fg-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .sbox__input {
    width: 100%;
    height: 3.25rem;
    padding: 0 1rem 0 2.85rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.75rem;
    background: var(--bg);
    color: var(--fg);
    font-size: 1.0625rem;
  }

  .sbox__input::placeholder {
    color: var(--fg-subtle);
  }

  .sbox__input:focus {
    border-color: var(--accent);
    outline: 2px solid color-mix(in oklab, var(--accent) 35%, transparent);
    outline-offset: 0;
  }

  .sbox__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .sbox__filter {
    height: 2rem;
    padding: 0 0.875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--fg-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .sbox__filter:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .sbox__filter[aria-checked='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }

  .sbox__status {
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .sbox__results {
    display: grid;
    gap: 0.625rem;
  }

  .sbox__results:empty {
    display: none;
  }

  .sbox__results :global(.sres) {
    display: grid;
    gap: 0.3rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
  }

  .sbox__results :global(.sres:hover),
  .sbox__results :global(.sres:focus-visible) {
    border-color: var(--accent);
    background: var(--surface);
  }

  .sbox__results :global(.sres__kicker) {
    color: var(--fg-subtle);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sbox__results :global(.sres__title) {
    font-weight: 650;
    line-height: 1.35;
  }

  .sbox__results :global(.sres__excerpt) {
    color: var(--fg-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .sbox__results :global(mark) {
    border-radius: 0.2rem;
    background: color-mix(in oklab, var(--copper) 22%, transparent);
    color: var(--fg);
  }

  .sbox__results :global(.sres__sections) {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.25rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--border);
  }

  .sbox__results :global(.sres__section) {
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .sbox__results :global(.sres__section:hover) {
    text-decoration: underline;
  }
</style>
