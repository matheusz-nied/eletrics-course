---
/*
 * A glossary term in the lesson text: <Term id="borne">borne</Term>.
 * The word becomes a button that opens a small popover with the definition and
 * a link to the glossary page. It works without JavaScript (Popover API);
 * the script places the popover next to the word and opens it on mouse hover.
 * An unknown id fails the build.
 */
import { getEntry } from 'astro:content';
import { termUrl } from './data';
import { uniqueId } from './ui/unique';

export interface Props {
  /** Glossary entry id, the file name in src/content/glossario without `.md`. */
  id: string;
}

const { id } = Astro.props;
const entry = await getEntry('glossario', id);
if (!entry) {
  throw new Error(
    `<Term id="${id}">: o termo "${id}" não existe em src/content/glossario/. Crie o arquivo ${id}.md ou corrija o id.`,
  );
}

// The same term can appear many times in a lesson.
const popId = uniqueId(`termo-${id}`);
---

<!-- prettier-ignore -->
<span class="term-wrap"><button type="button" class="term" data-term={id} popovertarget={popId} aria-description="Termo do glossário"><slot /></button><span id={popId} class="term-pop" popover="auto" data-term-pop data-pagefind-ignore><span class="term-pop__name">{entry.data.termo}</span> <span class="term-pop__text">{entry.data.resumo}</span> <a class="term-pop__link" href={termUrl(id)}>Ver no glossário</a></span></span>

<script>
  const GAP = 8;
  const EDGE = 12;
  const supported = typeof HTMLElement !== 'undefined' && 'popover' in HTMLElement.prototype;

  function place(button: HTMLElement, pop: HTMLElement) {
    const anchor = button.getBoundingClientRect();
    const width = pop.offsetWidth;
    const height = pop.offsetHeight;
    const vw = document.documentElement.clientWidth;
    const below = anchor.bottom + GAP + height <= window.innerHeight - EDGE;
    const top = below ? anchor.bottom + GAP : Math.max(EDGE, anchor.top - GAP - height);
    const left = Math.min(
      Math.max(EDGE, anchor.left + anchor.width / 2 - width / 2),
      vw - width - EDGE,
    );
    pop.style.top = `${Math.round(top)}px`;
    pop.style.left = `${Math.round(Math.max(EDGE, left))}px`;
    pop.dataset.side = below ? 'baixo' : 'cima';
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-term]')) {
    const pop = document.getElementById(button.getAttribute('popovertarget') ?? '');
    if (!pop || button.dataset.termReady !== undefined) continue;
    button.dataset.termReady = '';

    if (!supported) {
      // Old browsers: the word links to the glossary page.
      const link = pop.querySelector<HTMLAnchorElement>('a');
      button.addEventListener('click', () => link && (window.location.href = link.href));
      continue;
    }

    let byHover = false;
    let timer: number | undefined;
    const isOpen = () => pop.matches(':popover-open');
    const later = (fn: () => void, ms: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(fn, ms);
    };
    const reposition = () => isOpen() && place(button, pop);

    button.setAttribute('aria-expanded', 'false');
    pop.addEventListener('toggle', (event) => {
      const open = (event as ToggleEvent).newState === 'open';
      button.setAttribute('aria-expanded', String(open));
      if (open) {
        place(button, pop);
        window.addEventListener('scroll', reposition, { passive: true, capture: true });
        window.addEventListener('resize', reposition);
      } else {
        byHover = false;
        window.removeEventListener('scroll', reposition, { capture: true });
        window.removeEventListener('resize', reposition);
      }
    });

    // A click on a popover opened by hover keeps it open instead of closing it.
    button.addEventListener('click', (event) => {
      window.clearTimeout(timer);
      if (byHover && isOpen()) {
        event.preventDefault();
        byHover = false;
      }
    });

    button.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse' || isOpen()) return;
      later(() => {
        byHover = true;
        pop.showPopover();
      }, 350);
    });
    const leave = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') return;
      if (!isOpen()) return window.clearTimeout(timer);
      if (byHover) later(() => byHover && pop.hidePopover(), 300);
    };
    button.addEventListener('pointerleave', leave);
    pop.addEventListener('pointerleave', leave);
    pop.addEventListener('pointerenter', () => window.clearTimeout(timer));
  }
</script>

<style>
  .term {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: inherit;
    text-decoration: underline dotted;
    text-decoration-color: var(--fg-subtle);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
    cursor: help;
  }

  .term:hover,
  .term[aria-expanded='true'] {
    text-decoration-color: var(--accent);
    text-decoration-style: solid;
  }

  .term-pop {
    display: none;
  }

  .term-pop:popover-open {
    position: fixed;
    inset: auto;
    display: grid;
    gap: 0.375rem;
    width: min(22rem, calc(100vw - 1.5rem));
    margin: 0;
    padding: 0.875rem 1rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 0.75rem;
    background: var(--bg);
    box-shadow: var(--shadow-md);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
  }

  .term-pop__name {
    font-weight: 650;
  }

  .term-pop__text {
    color: var(--fg-muted);
  }

  .term-pop__link {
    justify-self: start;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  @media print {
    .term {
      text-decoration: none;
    }
  }
</style>
