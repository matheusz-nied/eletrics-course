---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { withBase } from '../lib/url';

interface Props {
  /** Image path under public/ ("/figuras/x.png"), external URL, or an imported image. */
  src?: string | ImageMetadata;
  /** Required with `src`. With an inline SVG child it names the whole drawing. */
  alt?: string;
  caption?: string;
  credit?: string;
  /** Uses the whole content column instead of the reading width. */
  wide?: boolean;
}

const { src, alt, caption, credit, wide = false } = Astro.props;

if (src !== undefined && (alt === undefined || alt.trim() === '')) {
  throw new Error(
    `<Figure src=...> precisa de alt (descrição da imagem para quem não enxerga). Figura: ${
      typeof src === 'string' ? src : src.src
    }`,
  );
}
if (src === undefined && !Astro.slots.has('default')) {
  throw new Error('<Figure> precisa de src ou de um SVG como filho.');
}

const url = typeof src === 'string' ? (src.startsWith('/') ? withBase(src) : src) : undefined;
---

<figure class:list={['figure', { breakout: wide }]}>
  {src === undefined ? (
    <div class="figure__media" role={alt ? 'img' : undefined} aria-label={alt}>
      <slot />
    </div>
  ) : (
    <div class="figure__media">
      {url ? (
        <img src={url} alt={alt} loading="lazy" decoding="async" />
      ) : (
        <Image src={src as ImageMetadata} alt={alt ?? ''} />
      )}
    </div>
  )}
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && <span class="figure__credit">{credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  .figure {
    margin: 1.75em 0;
  }

  .figure__media {
    display: grid;
    place-items: center;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--fg);
    overflow-x: auto;
  }

  .figure__media :global(svg) {
    max-width: 100%;
    height: auto;
  }

  .figure__media :global(img) {
    border-radius: calc(var(--radius) - 0.25rem);
  }

  figcaption {
    margin-top: 0.6rem;
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .figure__credit {
    display: block;
    margin-top: 0.15rem;
    color: var(--fg-subtle);
    font-size: 0.8125rem;
  }
</style>
