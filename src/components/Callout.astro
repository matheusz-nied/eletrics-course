---
import Icon from './Icon.astro';
import type { IconName } from './icons';

export type CalloutType = 'perigo' | 'atencao' | 'dica' | 'nota' | 'seguranca-rede';

interface Props {
  type?: CalloutType;
  title?: string;
}

const KINDS: Record<CalloutType, { label: string; icon: IconName }> = {
  perigo: { label: 'Perigo', icon: 'perigo' },
  atencao: { label: 'Atenção', icon: 'atencao' },
  dica: { label: 'Dica', icon: 'dica' },
  nota: { label: 'Nota', icon: 'nota' },
  'seguranca-rede': { label: 'Segurança na rede elétrica', icon: 'seguranca' },
};

const { type = 'nota', title } = Astro.props;
const kind = KINDS[type];
if (!kind) {
  throw new Error(
    `<Callout type="${type}">: tipo desconhecido. Use ${Object.keys(KINDS).join(', ')}.`,
  );
}
const heading = title ?? kind.label;
const hasBody = Astro.slots.has('default');
---

<div class:list={['callout', `callout--${type}`]} role="note" aria-label={heading}>
  <p class="callout__title">
    <Icon name={kind.icon} size={20} />
    <span>{heading}</span>
  </p>
  <div class="callout__body">
    {type === 'seguranca-rede' && (
      <ul class="callout__rules">
        <li>
          <strong>Desligue o disjuntor</strong> do circuito antes de mexer em qualquer fio.
        </li>
        <li>
          <strong>Teste a ausência de tensão</strong> com um instrumento que você acabou de testar
          numa tomada energizada.
        </li>
        <li>
          <strong>Sinalize o quadro</strong> para ninguém religar o disjuntor enquanto você
          trabalha.
        </li>
        <li>
          <strong>Nunca trabalhe sozinho</strong> em rede energizada.
        </li>
        <li>
          Se não tiver segurança em qualquer etapa, <strong>chame um eletricista habilitado</strong>
          .
        </li>
      </ul>
    )}
    {hasBody && <slot />}
  </div>
</div>

<style>
  .callout {
    --c-fg: var(--info);
    --c-bg: var(--info-soft);
    --c-border: var(--info-border);
    position: relative;
    padding: 1rem 1.125rem 1rem 1.25rem;
    border: 1px solid var(--c-border);
    border-left-width: 4px;
    border-radius: var(--radius);
    background: var(--c-bg);
    font-size: 0.95em;
    line-height: 1.65;
  }

  .callout--perigo {
    --c-fg: var(--danger);
    --c-bg: var(--danger-soft);
    --c-border: var(--danger-border);
  }

  .callout--atencao {
    --c-fg: var(--warning);
    --c-bg: var(--warning-soft);
    --c-border: var(--warning-border);
  }

  .callout--dica {
    --c-fg: var(--success);
    --c-bg: var(--success-soft);
    --c-border: var(--success-border);
  }

  .callout--seguranca-rede {
    --c-fg: var(--danger);
    --c-bg: var(--danger-soft);
    --c-border: var(--danger-border);
    padding-left: 1.75rem;
    border-left-width: 1px;
  }

  .callout--seguranca-rede::before {
    content: '';
    position: absolute;
    inset: -1px auto -1px -1px;
    width: 0.625rem;
    border-radius: var(--radius) 0 0 var(--radius);
    background: var(--hazard);
  }

  .callout__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--c-fg);
    font-weight: 650;
    line-height: 1.3;
  }

  .callout__title :global(svg) {
    flex: none;
  }

  .callout__body {
    margin-top: 0.5rem;
  }

  .callout__body > :global(* + *) {
    margin-top: 0.75em;
  }

  .callout__rules {
    margin: 0;
    padding-left: 1.25em;
    list-style: disc;
  }

  .callout__rules li + li {
    margin-top: 0.3em;
  }
</style>
