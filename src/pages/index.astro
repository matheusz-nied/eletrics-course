---
/*
 * Provisional home page from the Fundação. The Experiência front replaces it
 * with the real one (tracks, progress, "continue where you left off").
 */
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCourse, lessonsOf, type Module } from '../lib/content';
import { PARTS, SITE } from '../lib/site';
import { lessonUrl, moduleUrl } from '../lib/url';

const { modules, listed } = await getCourse();
const first = listed[0];

const parts = new Map<number, Module[]>();
for (const m of modules) parts.set(m.data.parte, [...(parts.get(m.data.parte) ?? []), m]);

const pillars = [
  {
    icon: 'circuito',
    title: 'Simulações de verdade',
    text: 'Circuitos calculados como num simulador profissional: o LED queima, o fusível rompe e o motor zumbe sem capacitor.',
  },
  {
    icon: 'chip',
    title: 'Componentes em 3D',
    text: 'Gire, abra e corte cada peça para ver onde fica cada terminal e o que existe dentro dela.',
  },
  {
    icon: 'portao',
    title: 'Casos reais',
    text: 'Da tomada ao motor do portão: cada aula termina numa situação da vida real, com segurança em primeiro lugar.',
  },
] as const;
---

<BaseLayout>
  <main id="conteudo" tabindex="-1" class="home">
    <section class="hero">
      <p class="eyebrow">{SITE.fullName}</p>
      <h1>Entenda a eletricidade e a eletrônica, do princípio à bancada.</h1>
      <p class="hero__lead">
        Aulas claras, simulações que calculam de verdade e modelos 3D dos componentes. Você aprende
        como as coisas funcionam e como fazer: medir, ligar, montar e consertar com segurança.
      </p>
      <div class="hero__actions">
        {first ? (
          <a href={lessonUrl(first.id)} class="btn btn--primary">
            Começar pela primeira aula
            <Icon name="seta-direita" size={18} />
          </a>
        ) : (
          <a href="#modulos" class="btn btn--primary">
            Ver os módulos
            <Icon name="seta-direita" size={18} />
          </a>
        )}
      </div>
      <ul class="pillars">
        {pillars.map((p) => (
          <li class="pillar">
            <span class="pillar__icon">
              <Icon name={p.icon} size={22} />
            </span>
            <span class="pillar__title">{p.title}</span> <span class="pillar__text">{p.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="modulos" class="modules" aria-labelledby="modulos-titulo">
      <h2 id="modulos-titulo">Módulos</h2>
      <p class="modules__note">
        O curso está sendo construído. Cada módulo aparece aqui assim que fica pronto.
      </p>
      {[...parts.entries()].map(([parte, mods]) => (
        <div class="part">
          <h3 class="eyebrow">
            Parte {parte} · {PARTS[parte]}
          </h3>
          <ul class="module-grid">
            {mods.map((m) => {
              const count = lessonsOf(listed, m.id).length;
              return (
                <li>
                  <a href={moduleUrl(m.id)} class="card module-card">
                    <span class="module-card__icon">
                      <Icon name={m.data.icone} size={22} />
                    </span>
                    <span class="module-card__number">Módulo {m.data.numero}</span>{' '}
                    <span class="module-card__title">{m.data.titulo}</span>{' '}
                    <span class="module-card__summary">{m.data.resumo}</span>{' '}
                    <span class="module-card__meta">
                      {count > 0 ? `${count} ${count === 1 ? 'aula' : 'aulas'}` : 'Em breve'}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .home:focus {
    outline: none;
  }

  @media (min-width: 48rem) {
    .home {
      padding: 0 1.5rem;
    }
  }

  .hero {
    padding: 3.5rem 0 3rem;
  }

  @media (min-width: 48rem) {
    .hero {
      padding: 6rem 0 4.5rem;
    }
  }

  .hero h1 {
    max-width: 48rem;
    margin-top: 1rem;
    font-size: clamp(2.25rem, 1.5rem + 3.6vw, 4rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 40rem;
    margin-top: 1.5rem;
    color: var(--fg-muted);
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  .hero__actions {
    margin-top: 2rem;
  }

  .pillars {
    display: grid;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  @media (min-width: 48rem) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .pillar {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .pillar__icon {
    color: var(--copper);
  }

  .pillar__title {
    font-weight: 650;
  }

  .pillar__text {
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .modules {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .modules h2 {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .modules__note {
    margin-top: 0.5rem;
    color: var(--fg-muted);
  }

  .part {
    margin-top: 2.5rem;
  }

  .module-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  @media (min-width: 40rem) {
    .module-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .module-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .module-card {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    height: 100%;
    padding: 1.25rem;
  }

  .module-card__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.5rem;
    border-radius: 0.625rem;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .module-card__number {
    color: var(--fg-subtle);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .module-card__title {
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .module-card__summary {
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .module-card__meta {
    margin-top: 0.5rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
