---
/*
 * 07.8: a typical electric shower taken apart (the SVG version of the
 * electric-shower 3D part). From the top: the cap with the water inlet, the
 * diaphragm, the contact block with the temperature switch, the heating
 * element on its base, the heating chamber with the earth terminal in
 * contact with the water, and the spray plate. Generic, no brand.
 */
const CX = 128;
const LX = 224;
const coil = Array.from({ length: 9 }, (_, i) => 222 + i * 8);
const holes = Array.from({ length: 9 }, (_, i) => CX - 48 + i * 12);
const labels = [
  { y: 17, at: CX + 34, main: 'Entrada da água', sub: ['e tampa'] },
  { y: 98, at: CX + 48, main: 'Diafragma', sub: ['liga com a água'] },
  { y: 144, at: CX + 54, main: 'Contatos e chave', sub: ['de temperatura'] },
  { y: 250, at: CX + 30, main: 'Resistência', sub: ['fio nu em espiral,', 'dentro da água'] },
  { y: 336, at: CX + 58, main: 'Câmara', sub: ['com o borne do terra'] },
  { y: 420, at: CX + 60, main: 'Espalhador', sub: ['(crivo)'] },
];
---

<svg viewBox="0 0 360 452" width="360" height="452" class="fig" aria-hidden="true">
  <path d={`M${CX} 8 V444`} class="axis" />

  <!-- Cap with the water inlet. -->
  <rect x={CX - 12} y="6" width="24" height="22" rx="3" class="pipe" />
  {[11, 16, 21].map((y) => (
    <path d={`M${CX - 12} ${y} H${CX + 12}`} class="thread" />
  ))}
  <path d={`M${CX - 54} 66 L${CX - 30} 28 H${CX + 30} L${CX + 54} 66 Z`} class="body" />

  <!-- Diaphragm and the contacts it pushes. -->
  <ellipse cx={CX} cy="100" rx="46" ry="9" class="rubber" />
  <rect x={CX - 20} y="84" width="40" height="7" rx="2" class="plate" />

  <!-- Contact block with the temperature switch lever. -->
  <rect x={CX - 50} y="124" width="100" height="40" rx="6" class="block" />
  {[-28, 0, 28].map((dx) => (
    <rect x={CX + dx - 5} y="116" width="10" height="9" rx="1" class="contact" />
  ))}
  <path d={`M${CX + 20} 164 L${CX + 36} 184`} class="lever" />
  <circle cx={CX + 38} cy="188" r="6" class="knob" />

  <!-- Supply wires and the earth wire, out to the left. -->
  <path d={`M${CX - 46} 134 C ${CX - 70} 134 ${CX - 90} 118 10 112`} class="cable black" />
  <path d={`M${CX - 46} 142 C ${CX - 74} 142 ${CX - 96} 126 10 122`} class="cable black" />
  <path d={`M${CX - 46} 299 H40 V132 H10`} class="cable earth" />
  <path d={`M${CX - 46} 299 H40 V132 H10`} class="cable earth-stripe" />
  <text x="8" y="84" class="t small">
    fios de
  </text>
  <text x="8" y="98" class="t small">
    alimentação
  </text>
  <text x="46" y="232" class="t small earth-t">
    terra
  </text>

  <!-- Heating element: a bare coil on its base. -->
  <rect x={CX - 40} y="196" width="80" height="16" rx="4" class="base" />
  {[-24, 0, 24].map((dx) => (
    <path d={`M${CX + dx} 196 V186`} class="pin" />
  ))}
  {coil.map((y) => (
    <ellipse cx={CX - 18} cy={y} rx="9" ry="4" class="coil" />
  ))}
  {coil.map((y) => (
    <ellipse cx={CX + 18} cy={y} rx="9" ry="4" class="coil" />
  ))}
  <path d={`M${CX - 18} 290 C ${CX - 18} 300 ${CX + 18} 300 ${CX + 18} 290`} class="coil-end" />

  <!-- Heating chamber with the earth terminal. -->
  <path d={`M${CX - 60} 312 H${CX + 60} L${CX + 48} 378 H${CX - 48} Z`} class="body" />
  <rect x={CX - 52} y="294" width="14" height="10" rx="2" class="earth-term" />

  <!-- Spray plate. -->
  <ellipse cx={CX} cy="420" rx="58" ry="12" class="plate-spray" />
  {holes.map((x) => (
    <circle cx={x} cy="420" r="1.8" class="hole" />
  ))}

  {labels.map((l) => (
    <g>
      <path d={`M${l.at} ${l.y} H${LX - 4}`} class="leader" />
      <text x={LX} y={l.y - 3} class="t strong">
        {l.main}
      </text>
      {l.sub.map((s, i) => (
        <text x={LX} y={l.y + 12 + i * 14} class="t small">
          {s}
        </text>
      ))}
    </g>
  ))}
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .axis {
    stroke: var(--border);
    stroke-dasharray: 4 6;
  }
  .pipe {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .thread {
    stroke: var(--fg-muted);
  }
  .body {
    fill: var(--bg);
    stroke: var(--fg-muted);
    stroke-width: 1.8;
  }
  .rubber {
    /* Black rubber, with an outline that shows it on the dark theme. */
    fill: #2a2a2e;
    stroke: var(--fg-muted);
    stroke-width: 1.2;
  }
  .plate {
    fill: var(--copper);
  }
  .block {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .contact {
    fill: var(--copper);
  }
  .lever {
    stroke: var(--fg-muted);
    stroke-width: 4;
  }
  .knob {
    fill: var(--accent);
  }
  .cable {
    stroke-width: 3;
  }
  .black {
    stroke: var(--fg);
  }
  .earth {
    stroke: var(--success);
  }
  .earth-stripe {
    stroke: var(--warning);
    stroke-dasharray: 5 7;
  }
  .base {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .pin {
    stroke: var(--copper);
    stroke-width: 3;
  }
  .coil,
  .coil-end {
    stroke: var(--copper);
    stroke-width: 1.8;
  }
  .earth-term {
    fill: var(--fg-muted);
  }
  .plate-spray {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .hole {
    fill: var(--fg-muted);
  }
  .leader {
    stroke: var(--fg-subtle);
    stroke-width: 1;
  }
  .t {
    fill: var(--fg-muted);
    font-size: 13px;
    stroke: none;
  }
  .strong {
    fill: var(--fg);
    font-weight: 700;
  }
  .small {
    font-size: 12px;
  }
  .earth-t {
    fill: var(--success);
    font-weight: 700;
  }
</style>
