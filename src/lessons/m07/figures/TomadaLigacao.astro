---
/*
 * 07.5: the back of an outlet module with the three conductors in place
 * (phase and neutral on the side terminals, earth on the middle one), and
 * three ways a stripped end can sit in a terminal. The side of the phase is
 * the installation's convention, not shown as a rule.
 */
const details = [
  { x: 10, title: 'certo', sub: 'cobre todo no borne', bare: 0, ok: true },
  { x: 126, title: 'errado', sub: 'cobre exposto', bare: 14, ok: false },
  { x: 242, title: 'errado', sub: 'isolação no borne', bare: -14, ok: false },
];
---

<svg viewBox="0 0 360 340" width="360" height="340" class="fig" aria-hidden="true">
  <!-- Back of the module -->
  <rect x="100" y="14" width="160" height="136" rx="10" class="module" />
  <text x="180" y="32" class="small">
    tomada vista por trás
  </text>
  <rect x="116" y="56" width="36" height="30" rx="4" class="terminal" />
  <rect x="208" y="56" width="36" height="30" rx="4" class="terminal" />
  <rect x="162" y="92" width="36" height="30" rx="4" class="terminal" />
  <circle cx="134" cy="71" r="7" class="screw" />
  <circle cx="226" cy="71" r="7" class="screw" />
  <circle cx="180" cy="107" r="7" class="screw" />
  <path d="M129 71 H139 M221 71 H231 M175 107 H185" class="slot" />

  <!-- Conductors from the box -->
  <path d="M134 80 V176 Q134 196 112 206 L60 226" class="w w-fase" />
  <path d="M226 80 V176 Q226 196 248 206 L300 226" class="w w-neutro" />
  <path d="M180 116 V226" class="w w-terra" />
  <path d="M180 116 V226" class="w w-stripe" />

  <text x="54" y="246" class="name start">
    fase
  </text>
  <text x="306" y="246" class="name end">
    neutro
  </text>
  <text x="180" y="244" class="name">
    terra
  </text>
  <text x="96" y="66" class="small end">
    borne
  </text>
  <text x="96" y="80" class="small end">
    lateral
  </text>
  <text x="264" y="66" class="small start">
    borne
  </text>
  <text x="264" y="80" class="small start">
    lateral
  </text>
  <text x="180" y="88" class="small">
    ⏚
  </text>

  <path d="M8 258 H352" class="sep" />

  {details.map((d) => (
    <g>
      <rect x={d.x + 8} y="270" width="40" height="30" rx="3" class="terminal" />
      <path d={`M${d.x + 20} 285 H${d.x + 46 + d.bare}`} class="copper" />
      <path d={`M${d.x + 48 + d.bare} 285 H${d.x + 104}`} class="insul" />
      <text x={d.x + 56} y="316" class={d.ok ? 'ok' : 'bad'}>
        {d.title}
      </text>
      <text x={d.x + 56} y="331" class="small">
        {d.sub}
      </text>
    </g>
  ))}
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .module {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .terminal {
    fill: color-mix(in oklab, var(--copper) 18%, var(--surface-2));
    stroke: var(--fg-muted);
    stroke-width: 1.2;
  }
  .screw {
    fill: var(--surface-2);
    stroke: var(--fg);
    stroke-width: 1.5;
  }
  .slot {
    stroke: var(--fg);
    stroke-width: 1.6;
  }
  .w {
    stroke-width: 6;
  }
  .w-fase {
    stroke: var(--danger);
  }
  .w-neutro {
    stroke: var(--info);
  }
  .w-terra {
    stroke: var(--success);
  }
  .w-stripe {
    stroke: light-dark(#d9b400, #f2d14b);
    stroke-dasharray: 5 7;
  }
  .sep {
    stroke: var(--border);
    stroke-width: 1;
  }
  .copper {
    stroke: var(--copper);
    stroke-width: 4;
  }
  .insul {
    stroke: var(--fg-muted);
    stroke-width: 8;
  }
  text {
    fill: var(--fg);
    stroke: none;
    font-size: 12px;
    text-anchor: middle;
  }
  .name {
    font-size: 13px;
    font-weight: 700;
  }
  .small {
    fill: var(--fg-muted);
    font-size: 11.5px;
  }
  .start {
    text-anchor: start;
  }
  .end {
    text-anchor: end;
  }
  .ok {
    fill: var(--success);
    font-size: 11px;
    font-weight: 600;
  }
  .bad {
    fill: var(--danger);
    font-size: 11px;
    font-weight: 600;
  }
</style>
