---
/*
 * 07.2: the TN earthing schemes. Top, TN-C-S: the utility brings phase and a
 * combined neutral-earth (PEN); at the service entrance it is grounded and
 * split into N and PE, which never meet again. Bottom, TN-S: N and PE run
 * separately from the transformer. In both, a fault to the case closes a
 * loop of wires only, so the fault current is large.
 */
const rows = [
  { y: 0, title: 'TN-C-S', note: 'neutro e terra juntos na rua (PEN), separados na entrada' },
  { y: 190, title: 'TN-S', note: 'neutro e terra separados desde o transformador' },
];
---

<svg viewBox="0 0 400 372" width="400" height="372" class="fig" aria-hidden="true">
  {rows.map(({ y, title, note }, i) => (
    <g transform={`translate(0 ${y})`}>
      <text x="8" y="18" class="title">
        {title}
      </text>
      <text x="8" y="36" class="small">
        {note}
      </text>
      {/* Transformer of the street */}
      <rect x="8" y="50" width="56" height="78" rx="6" class="box" />
      <text x="36" y="70" class="lbl mid">
        trafo
      </text>
      <text x="36" y="84" class="lbl mid">
        da rua
      </text>
      <path d="M36 128 V146" class="pe" />
      <path d="M24 146 H48 M28 151 H44 M32 156 H40" class="pe" />
      {/* Phase */}
      <path d="M64 62 H348" class="fase" />
      <text x="72" y="56" class="tag fase-t">
        F
      </text>
      {i === 0 ? (
        <>
          {/* PEN up to the entrance, then N and PE */}
          <path d="M64 100 H190" class="pen" />
          <path d="M64 100 H190" class="pen-stripe" />
          <text x="72" y="94" class="tag pen-t">
            PEN
          </text>
          <circle cx="190" cy="100" r="4" class="dot" />
          <path d="M190 100 H348" class="neutro" />
          <path d="M190 100 V128 H314" class="pe" />
          <path d="M190 128 V150" class="pe" />
          <path d="M178 150 H202 M182 155 H198 M186 160 H194" class="pe" />
          <text x="172" y="158" class="small end">
            haste da entrada
          </text>
        </>
      ) : (
        <>
          <path d="M64 100 H348" class="neutro" />
          <path d="M64 118 H120 V128 H314" class="pe" />
          <text x="72" y="134" class="tag pe-t">
            PE
          </text>
          <text x="72" y="94" class="tag neutro-t">
            N
          </text>
        </>
      )}
      <text x="262" y="94" class="tag neutro-t">
        N
      </text>
      <text x="262" y="122" class="tag pe-t">
        PE
      </text>
      {/* The house and an appliance with a metal case */}
      <rect x="236" y="44" width="156" height="128" rx="8" class="house" />
      <text x="384" y="164" class="small end">
        casa
      </text>
      <rect x="314" y="54" width="62" height="82" rx="4" class="case" />
      <path d="M348 62 V76 M348 100 V86" class="load" />
      <rect x="341" y="76" width="14" height="10" class="load" />
      <circle cx="314" cy="128" r="3" class="dot pe-dot" />
      <text x="345" y="150" class="small mid">
        carcaça no PE
      </text>
    </g>
  ))}
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--fg);
  }
  .fase,
  .neutro,
  .pe,
  .pen,
  .pen-stripe {
    stroke-width: 2.6;
  }
  .fase {
    stroke: var(--danger);
  }
  .neutro {
    stroke: var(--accent);
  }
  .pe {
    stroke: var(--success);
  }
  .pen {
    stroke: var(--accent);
  }
  .pen-stripe {
    stroke: var(--success);
    stroke-dasharray: 8 8;
  }
  .box,
  .house {
    stroke: var(--fg-subtle);
    stroke-width: 1.5;
  }
  .house {
    stroke-dasharray: 6 4;
  }
  .case {
    stroke: var(--fg-muted);
    stroke-width: 2;
  }
  .load {
    stroke: var(--fg);
    stroke-width: 2;
  }
  .dot {
    fill: var(--fg);
    stroke: none;
  }
  .pe-dot {
    fill: var(--success);
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 13px;
  }
  .title {
    font-size: 15px;
    font-weight: 700;
  }
  .small {
    fill: var(--fg-muted);
    font-size: 12px;
  }
  .lbl {
    fill: var(--fg-muted);
  }
  .mid {
    text-anchor: middle;
  }
  .end {
    text-anchor: end;
  }
  .tag {
    font-weight: 700;
  }
  .fase-t {
    fill: var(--danger);
  }
  .neutro-t,
  .pen-t {
    fill: var(--accent);
  }
  .pe-t {
    fill: var(--success);
  }
</style>
