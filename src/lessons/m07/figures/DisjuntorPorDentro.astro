---
/*
 * 07.3: a miniature circuit breaker in cut. The current (red) enters at the
 * top terminal, goes through the coil of the magnetic release, the contacts
 * and the bimetal strip, and leaves at the bottom terminal. The coil pulls
 * its plunger at once on a short circuit; the bimetal bends slowly when it
 * heats with an overload; either one releases the latch and the spring opens
 * the contacts. The arc that forms between them is drawn into the arc chute.
 */
const labels: { y: number; text: string[]; x: number; to: [number, number]; side: 'l' | 'r' }[] = [
  { y: 44, text: ['borne de entrada'], x: 116, to: [170, 46], side: 'l' },
  { y: 104, text: ['bobina', '(disparo', 'magnético)'], x: 290, to: [252, 112], side: 'r' },
  { y: 150, text: ['alavanca'], x: 116, to: [134, 158], side: 'l' },
  { y: 206, text: ['contatos'], x: 116, to: [186, 214], side: 'l' },
  { y: 246, text: ['câmara de', 'extinção do arco'], x: 290, to: [262, 248], side: 'r' },
  { y: 300, text: ['bimetal', '(disparo térmico)'], x: 116, to: [170, 300], side: 'l' },
  { y: 356, text: ['borne de saída'], x: 290, to: [232, 358], side: 'r' },
];
---

<svg viewBox="0 0 400 404" width="400" height="404" class="fig" aria-hidden="true">
  <!-- Housing -->
  <rect x="128" y="16" width="144" height="364" rx="10" class="housing"></rect>

  <!-- Terminals -->
  <rect x="170" y="30" width="60" height="30" rx="3" class="terminal"></rect>
  <rect x="170" y="340" width="60" height="30" rx="3" class="terminal"></rect>

  <!-- Coil with its plunger -->
  <path
    d="M222 60 V80 C252 80 252 92 222 92 C252 92 252 104 222 104 C252 104 252 116 222 116 C252 116 252 128 222 128 V170 H206 V196"
    class="path"
  ></path>
  <rect x="228" y="84" width="12" height="44" rx="2" class="plunger"></rect>
  <path d="M234 128 V150 L178 168" class="link"></path>

  <!-- Lever and latch -->
  <rect x="120" y="140" width="22" height="36" rx="4" class="lever"></rect>
  <path d="M142 158 L178 168" class="mech"></path>
  <circle cx="178" cy="168" r="4" class="pivot"></circle>

  <!-- Contacts: fixed (top) and moving arm (from the latch) -->
  <rect x="200" y="196" width="12" height="8" class="contact"></rect>
  <path d="M178 168 L186 206 L204 210" class="arm"></path>
  <rect x="200" y="206" width="12" height="8" class="contact"></rect>

  <!-- Arc chute: a stack of steel plates -->
  <path
    d="M226 222 H262 M226 232 H262 M226 242 H262 M226 252 H262 M226 262 H262 M226 272 H262"
    class="plates"
  ></path>

  <!-- Braid to the bimetal, bimetal to the bottom terminal -->
  <path d="M186 206 C160 230 168 250 176 262" class="path"></path>
  <rect x="172" y="262" width="5" height="64" class="bimetal-a"></rect>
  <rect x="177" y="262" width="5" height="64" class="bimetal-b"></rect>
  <path d="M182 326 C200 330 200 340 200 340" class="path"></path>
  <path d="M174 262 L174 240 L178 168" class="link"></path>

  <!-- Labels -->
  {labels.map(({ y, text, x, to, side }) => (
    <>
      <path d={`M${side === 'l' ? x + 4 : x - 4} ${y - 4} L${to[0]} ${to[1]}`} class="leader" />
      {text.map((t, i) => (
        <text x={x} y={y + i * 15} class={side === 'l' ? 'end' : ''}>
          {t}
        </text>
      ))}
    </>
  ))}
  <text x="200" y="398" class="small mid">
    a corrente percorre o caminho em vermelho
  </text>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .housing {
    stroke: var(--fg-subtle);
    stroke-width: 2;
    fill: color-mix(in oklab, var(--fg-subtle) 8%, transparent);
  }
  .terminal {
    stroke: var(--fg-muted);
    stroke-width: 2;
    fill: color-mix(in oklab, var(--copper) 30%, transparent);
  }
  .path {
    stroke: var(--danger);
    stroke-width: 3;
  }
  .plunger {
    stroke: var(--fg-muted);
    stroke-width: 1.5;
    fill: color-mix(in oklab, var(--fg-muted) 30%, transparent);
  }
  .link {
    stroke: var(--fg-muted);
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
  }
  .lever {
    stroke: var(--fg);
    stroke-width: 2;
    fill: var(--surface);
  }
  .mech,
  .arm {
    stroke: var(--fg);
    stroke-width: 2.6;
  }
  .pivot {
    fill: var(--fg);
    stroke: none;
  }
  .contact {
    fill: var(--copper);
    stroke: none;
  }
  .plates {
    stroke: var(--fg-muted);
    stroke-width: 3;
  }
  .bimetal-a {
    fill: var(--copper);
    stroke: none;
  }
  .bimetal-b {
    fill: var(--fg-muted);
    stroke: none;
  }
  .leader {
    stroke: var(--fg-subtle);
    stroke-width: 1;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 12.5px;
  }
  .small {
    fill: var(--fg-muted);
    font-size: 12px;
  }
  .mid {
    text-anchor: middle;
  }
  .end {
    text-anchor: end;
  }
</style>
