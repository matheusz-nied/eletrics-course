---
/*
 * 07.5: an outlet set taken apart, from the front of the wall to the box:
 * cover plate, outlet module (front and back), mounting frame and the 4×2
 * box with the three conductors. Generic, no maker's design. Fallback of the
 * 3D part "outlet-nbr14136".
 */
const labels = [
  { y: 52, lines: ['Placa (espelho)', 'o acabamento; encaixa', 'no suporte'] },
  {
    y: 156,
    lines: [
      'Módulo da tomada',
      'corpo plástico, contatos',
      'de latão ou bronze e',
      'os bornes atrás',
    ],
  },
  { y: 270, lines: ['Suporte', 'segura os módulos e', 'é parafusado na caixa'] },
  { y: 372, lines: ['Caixa 4×2', 'embutida na parede;', 'por ela chegam fase,', 'neutro e terra'] },
];
---

<svg viewBox="0 0 360 440" width="360" height="440" class="fig" aria-hidden="true">
  <!-- Explosion axis -->
  <path d="M120 100 V128 M120 212 V236 M120 304 V330" class="axis" />
  <path
    d="M115 122 L120 130 L125 122 M115 230 L120 238 L125 230 M115 324 L120 332 L125 324"
    class="axis-head"
  />

  <!-- 1. Cover plate -->
  <rect x="30" y="16" width="180" height="84" rx="10" class="plate" />
  <rect x="92" y="26" width="56" height="64" rx="5" class="opening" />

  <!-- 2. Module: front (left) and back with the terminals (right) -->
  <rect x="42" y="130" width="56" height="80" rx="6" class="module" />
  <path d="M56 148 H84 L92 170 L84 192 H56 L48 170 Z" class="recess" />
  <circle cx="60" cy="168" r="4" class="hole" />
  <circle cx="80" cy="168" r="4" class="hole" />
  <circle cx="70" cy="174" r="4" class="hole" />
  <text x="70" y="224" class="tiny">
    frente
  </text>

  <rect x="142" y="130" width="56" height="80" rx="6" class="module" />
  <path d="M152 146 V160 M188 146 V160 M170 186 V198" class="contact" />
  <circle cx="152" cy="168" r="6" class="screw" />
  <circle cx="188" cy="168" r="6" class="screw" />
  <circle cx="170" cy="178" r="6" class="screw" />
  <path d="M148 168 H156 M184 168 H192 M166 178 H174" class="slot" />
  <text x="170" y="224" class="tiny">
    atrás: bornes
  </text>

  <!-- 3. Mounting frame -->
  <rect x="30" y="240" width="180" height="62" rx="6" class="frame" />
  <rect x="86" y="248" width="68" height="46" rx="4" class="opening" />
  <rect x="40" y="264" width="16" height="12" rx="6" class="slotted" />
  <rect x="184" y="264" width="16" height="12" rx="6" class="slotted" />

  <!-- 4. 4×2 box with the conductors -->
  <path d="M24 336 H216 V416 H24 Z" class="box" />
  <rect x="34" y="346" width="172" height="60" rx="4" class="box-inner" />
  <circle cx="44" cy="376" r="5" class="screw" />
  <circle cx="196" cy="376" r="5" class="screw" />
  <path d="M100 406 C100 390 108 378 112 360" class="w-fase" />
  <path d="M120 406 C120 390 122 378 124 360" class="w-neutro" />
  <path d="M140 406 C140 390 136 378 136 360" class="w-terra" />
  <path d="M140 406 C140 390 136 378 136 360" class="w-terra-stripe" />

  {labels.map((l) =>
    l.lines.map((line, i) => (
      <text x="222" y={l.y + i * 15} class={i === 0 ? 'name' : 'desc'}>
        {line}
      </text>
    )),
  )}
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .axis {
    stroke: var(--fg-subtle);
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }
  .axis-head {
    stroke: var(--fg-subtle);
    stroke-width: 1.2;
  }
  .plate {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .opening {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 1.2;
  }
  .module {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .recess {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 1.2;
  }
  .hole {
    fill: var(--fg);
  }
  .contact {
    stroke: var(--copper);
    stroke-width: 4;
  }
  .screw {
    fill: var(--surface-2);
    stroke: var(--fg);
    stroke-width: 1.5;
  }
  .slot {
    stroke: var(--fg);
    stroke-width: 1.5;
  }
  .frame {
    fill: color-mix(in oklab, var(--fg-subtle) 14%, var(--bg));
    stroke: var(--fg);
    stroke-width: 2;
  }
  .slotted {
    fill: var(--bg);
    stroke: var(--fg-muted);
    stroke-width: 1.2;
  }
  .box {
    fill: color-mix(in oklab, var(--warning) 14%, var(--bg));
    stroke: var(--fg);
    stroke-width: 2;
  }
  .box-inner {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 1;
  }
  .w-fase,
  .w-neutro,
  .w-terra,
  .w-terra-stripe {
    stroke-width: 5;
  }
  .w-fase {
    stroke: var(--danger);
  }
  .w-neutro {
    stroke: var(--info);
  }
  .w-terra {
    stroke: var(--success);
  }
  .w-terra-stripe {
    stroke: light-dark(#d9b400, #f2d14b);
    stroke-dasharray: 4 6;
  }
  text {
    fill: var(--fg);
    stroke: none;
    font-size: 12px;
  }
  .name {
    font-weight: 700;
    font-size: 13px;
  }
  .desc {
    fill: var(--fg-muted);
    font-size: 11.5px;
  }
  .tiny {
    fill: var(--fg-muted);
    font-size: 11px;
    text-anchor: middle;
  }
</style>
