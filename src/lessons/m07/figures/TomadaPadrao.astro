---
/*
 * 07.5: the NBR 14136 outlet and plugs seen from the front. The 10 A and
 * 20 A outlets differ only in the hole size (pins of 4,0 mm and 4,8 mm); the
 * earth hole sits in the middle, a little off the line of the other two.
 * Proportions are schematic.
 */
const outlets = [
  { cx: 92, title: 'Tomada de 10 A', hole: 5.5, note: 'furos menores' },
  { cx: 268, title: 'Tomada de 20 A', hole: 7, note: 'furos maiores' },
];
const plugs = [
  { cx: 62, title: '2 pinos, 10 A', pin: 5.5, earth: false, note: 'sem terra' },
  { cx: 180, title: '3 pinos, 10 A', pin: 5.5, earth: true, note: 'pinos de 4,0 mm' },
  { cx: 298, title: '3 pinos, 20 A', pin: 7, earth: true, note: 'pinos de 4,8 mm' },
];
const hex = (cx: number, cy: number, w: number, h: number) =>
  `M${cx - w / 2 + h / 3} ${cy - h / 2} H${cx + w / 2 - h / 3} L${cx + w / 2} ${cy} L${cx + w / 2 - h / 3} ${cy + h / 2} H${cx - w / 2 + h / 3} L${cx - w / 2} ${cy} Z`;
---

<svg viewBox="0 0 360 330" width="360" height="330" class="fig" aria-hidden="true">
  {outlets.map((o) => (
    <g>
      <text x={o.cx} y="18" class="title">
        {o.title}
      </text>
      <rect x={o.cx - 62} y="28" width="124" height="112" rx="14" class="plate" />
      <path d={hex(o.cx, 84, 100, 74)} class="recess" />
      <circle cx={o.cx - 26} cy="80" r={o.hole} class="hole" />
      <circle cx={o.cx + 26} cy="80" r={o.hole} class="hole" />
      <circle cx={o.cx} cy="90" r={o.hole} class="hole" />
      <text x={o.cx} y="158" class="small">
        {o.note}
      </text>
    </g>
  ))}
  <text x="180" y="66" class="tag">
    rebaixo
  </text>
  <path d="M180 70 V78 M180 70 L126 78 M180 70 L234 78" class="pointer" />

  <path d="M12 176 H348" class="sep" />

  {plugs.map((p) => (
    <g>
      <text x={p.cx} y="198" class="title">
        {p.title}
      </text>
      <path d={hex(p.cx, 246, 92, 60)} class="plug" />
      <circle cx={p.cx - 22} cy="242" r={p.pin} class="pin" />
      <circle cx={p.cx + 22} cy="242" r={p.pin} class="pin" />
      {p.earth && <circle cx={p.cx} cy="252" r={p.pin} class="pin earth" />}
      <text x={p.cx} y="294" class="small">
        {p.note}
      </text>
    </g>
  ))}
  <text x="180" y="318" class="legend">
    O pino do meio é o terra, fora da linha dos outros dois.
  </text>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linejoin: round;
  }
  .plate {
    fill: var(--bg);
    stroke: var(--border-strong);
    stroke-width: 2;
  }
  .recess {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .hole {
    fill: var(--fg);
  }
  .plug {
    fill: var(--surface-2);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .pin {
    fill: var(--copper);
    stroke: var(--fg);
    stroke-width: 1;
  }
  .earth {
    fill: color-mix(in oklab, var(--success) 55%, var(--copper));
  }
  .pointer {
    stroke: var(--fg-subtle);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  .sep {
    stroke: var(--border);
    stroke-width: 1;
  }
  text {
    fill: var(--fg);
    stroke: none;
    font-size: 13px;
    text-anchor: middle;
  }
  .title {
    font-weight: 700;
  }
  .small {
    fill: var(--fg-muted);
    font-size: 12px;
  }
  .tag {
    fill: var(--fg-muted);
    font-size: 11px;
  }
  .legend {
    font-size: 12px;
  }
</style>
