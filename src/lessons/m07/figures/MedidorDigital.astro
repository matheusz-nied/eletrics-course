---
/*
 * 07.1: an electronic energy meter seen from the front (generic, no brand):
 * the display with the accumulated kWh, the pulse LED and the seal; beside it,
 * the monthly consumption from two readings.
 */
---

<svg viewBox="0 0 420 250" width="420" height="250" class="fig" aria-hidden="true">
  <!-- Meter -->
  <rect x="14" y="14" width="190" height="222" rx="12" class="case" />
  <rect x="34" y="44" width="150" height="46" rx="4" class="display" />
  <text x="150" y="76" class="digits">
    12480
  </text>
  <text x="176" y="76" class="unit">
    kWh
  </text>
  <circle cx="52" cy="118" r="6" class="led" />
  <text x="66" y="122" class="small">
    pisca com o consumo
  </text>
  <text x="34" y="150" class="small">
    constante: imp/kWh
  </text>
  <text x="34" y="168" class="small">
    (vem escrita no medidor)
  </text>
  <path d="M60 210 H158" class="terminals" />
  <circle cx="110" cy="210" r="7" class="seal" />
  <text x="110" y="230" class="small mid">
    lacre
  </text>
  <text x="109" y="34" class="lbl mid strong">
    Medidor de energia
  </text>

  <!-- Two readings -->
  <text x="222" y="54" class="lbl strong">
    A conta do mês
  </text>
  <text x="222" y="84" class="lbl">
    Atual
  </text>
  <text x="404" y="84" class="lbl end num">
    12.480 kWh
  </text>
  <text x="222" y="108" class="lbl">
    Anterior
  </text>
  <text x="404" y="108" class="lbl end num">
    − 12.270 kWh
  </text>
  <path d="M222 120 H404" class="rule" />
  <text x="222" y="142" class="lbl strong">
    Consumo
  </text>
  <text x="404" y="142" class="lbl end strong num">
    210 kWh
  </text>
  <text x="222" y="176" class="small">
    Vezes a tarifa da sua
  </text>
  <text x="222" y="192" class="small">
    distribuidora (R$ por kWh),
  </text>
  <text x="222" y="208" class="small">
    mais impostos e bandeira.
  </text>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .case {
    fill: var(--surface-2);
    stroke: var(--fg-muted);
    stroke-width: 2;
  }
  .display {
    fill: light-dark(#dfe9d6, #1b2a1d);
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .digits {
    font-family: var(--font-mono);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 2px;
    text-anchor: end;
  }
  .unit {
    fill: var(--fg-muted);
    font-size: 11px;
    text-anchor: end;
  }
  .led {
    fill: var(--danger);
    stroke: none;
  }
  .terminals {
    stroke: var(--fg-muted);
    stroke-width: 10;
  }
  .seal {
    fill: var(--warning);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .rule {
    stroke: var(--fg-muted);
    stroke-width: 1.2;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 13px;
  }
  .digits {
    fill: var(--fg);
  }
  .strong {
    font-weight: 700;
  }
  .mid {
    text-anchor: middle;
  }
  .end {
    text-anchor: end;
  }
  .num {
    font-variant-numeric: tabular-nums;
  }
  .small {
    fill: var(--fg-muted);
    font-size: 12px;
  }
</style>
