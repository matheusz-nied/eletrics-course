---
/*
 * Lesson 1.3: an alkaline AA cell cut lengthwise. The steel can and the
 * manganese dioxide pressed against it form the positive side; the zinc gel
 * in the middle and the brass collector form the negative side.
 */
import Figure from '../../../components/Figure.astro';
---

<Figure
  wide
  alt="Corte de uma pilha alcalina AA deitada. Por fora, a carcaça de aço, que termina à direita no terminal positivo, o pequeno ressalto. Encostada na carcaça, por dentro, uma camada escura de dióxido de manganês. Depois, um separador fino e, no centro, o zinco em pó misturado ao eletrólito. Um pino de latão atravessa o zinco pelo meio e vai até a tampa do lado esquerdo, que é o terminal negativo, isolada da carcaça por uma vedação de plástico."
  caption="Uma pilha alcalina AA por dentro. A reação química entre o zinco do centro e o dióxido de manganês da parede empurra elétrons para o terminal negativo. A tensão de cerca de 1,5 V vem desses dois materiais, não do tamanho: AAA, AA, C e D têm a mesma tensão e guardam quantidades diferentes de energia."
>
  <svg
    class="fig-pilha"
    viewBox="0 0 680 260"
    width="680"
    height="260"
    fill="none"
    stroke-linejoin="round"
    font-family="var(--font-sans)"
    font-size="13"
  >
    <!-- Steel can (positive) -->
    <rect
      x="118"
      y="88"
      width="404"
      height="104"
      rx="10"
      class="fig-pilha__can"
      stroke-width="2.5"
    ></rect>
    <!-- Positive nub -->
    <rect
      x="520"
      y="118"
      width="18"
      height="44"
      rx="5"
      class="fig-pilha__can"
      stroke-width="2.5"
    ></rect>

    <!-- Cathode: manganese dioxide pressed against the can -->
    <rect x="150" y="96" width="364" height="18" class="fig-pilha__cathode"></rect>
    <rect x="150" y="166" width="364" height="18" class="fig-pilha__cathode"></rect>

    <!-- Separator -->
    <path d="M150 116h364M150 164h364" class="fig-pilha__separator" stroke-width="2.5"></path>

    <!-- Anode: zinc gel -->
    <rect x="152" y="118" width="360" height="44" class="fig-pilha__anode"></rect>
    <g class="fig-pilha__grains">
      <circle cx="190" cy="128" r="2"></circle>
      <circle cx="232" cy="153" r="2"></circle>
      <circle cx="268" cy="126" r="2"></circle>
      <circle cx="312" cy="152" r="2"></circle>
      <circle cx="350" cy="125" r="2"></circle>
      <circle cx="396" cy="154" r="2"></circle>
      <circle cx="430" cy="127" r="2"></circle>
      <circle cx="470" cy="150" r="2"></circle>
      <circle cx="492" cy="129" r="2"></circle>
      <circle cx="210" cy="150" r="2"></circle>
      <circle cx="455" cy="152" r="2"></circle>
    </g>

    <!-- Seal and negative end cap -->
    <rect x="120" y="92" width="30" height="96" rx="4" class="fig-pilha__seal"></rect>
    <rect
      x="104"
      y="98"
      width="14"
      height="84"
      rx="4"
      class="fig-pilha__cap"
      stroke-width="2.5"
    ></rect>

    <!-- Brass collector -->
    <rect x="118" y="136" width="330" height="8" rx="4" class="fig-pilha__brass"></rect>

    <!-- Polarity marks -->
    <text x="560" y="146" class="fig-pilha__pole">
      +
    </text>
    <text x="86" y="146" text-anchor="end" class="fig-pilha__pole">
      −
    </text>

    <!-- Top labels -->
    <path d="M135 62v30M330 62v34M490 62v26" class="fig-pilha__leader" stroke-width="1.2"></path>
    <text x="135" y="54" text-anchor="middle" class="fig-pilha__label">
      vedação de plástico
    </text>
    <text x="330" y="40" text-anchor="middle" class="fig-pilha__label">
      dióxido de manganês
    </text>
    <text x="330" y="56" text-anchor="middle" class="fig-pilha__small">
      lado positivo
    </text>
    <text x="490" y="40" text-anchor="middle" class="fig-pilha__label">
      carcaça de aço
    </text>
    <text x="490" y="56" text-anchor="middle" class="fig-pilha__small">
      liga ao terminal +
    </text>

    <!-- Bottom labels -->
    <path
      d="M200 140v62M380 160v42M560 202l-48-36"
      class="fig-pilha__leader"
      stroke-width="1.2"
    ></path>
    <text x="200" y="220" text-anchor="middle" class="fig-pilha__label">
      coletor de latão
    </text>
    <text x="200" y="236" text-anchor="middle" class="fig-pilha__small">
      liga ao terminal −
    </text>
    <text x="380" y="220" text-anchor="middle" class="fig-pilha__label">
      zinco em pó com eletrólito
    </text>
    <text x="380" y="236" text-anchor="middle" class="fig-pilha__small">
      lado negativo
    </text>
    <text x="570" y="220" text-anchor="middle" class="fig-pilha__label">
      separador
    </text>
  </svg>
</Figure>

<style>
  .fig-pilha {
    color: var(--fg);
  }

  .fig-pilha text {
    fill: currentColor;
    stroke: none;
  }

  .fig-pilha__label {
    font-weight: 600;
  }

  .fig-pilha .fig-pilha__small {
    fill: var(--fg-muted);
    font-size: 12px;
  }

  .fig-pilha .fig-pilha__pole {
    font-size: 26px;
    font-weight: 700;
  }

  .fig-pilha__can {
    stroke: var(--fg-muted);
    fill: color-mix(in oklab, var(--fg-subtle) 22%, var(--bg));
  }

  .fig-pilha__cap {
    stroke: var(--fg-muted);
    fill: color-mix(in oklab, var(--fg-subtle) 40%, var(--bg));
  }

  .fig-pilha__cathode {
    fill: color-mix(in oklab, var(--fg) 62%, var(--bg));
  }

  .fig-pilha__separator {
    stroke: color-mix(in oklab, #d9c58f 80%, var(--bg));
  }

  .fig-pilha__anode {
    fill: color-mix(in oklab, var(--fg-subtle) 28%, var(--bg));
  }

  .fig-pilha__grains circle {
    fill: color-mix(in oklab, var(--fg) 35%, var(--bg));
  }

  .fig-pilha__seal {
    fill: color-mix(in oklab, var(--accent) 35%, var(--bg));
  }

  .fig-pilha__brass {
    fill: #c9a24a;
  }

  .fig-pilha__leader {
    stroke: var(--fg-muted);
  }
</style>
