---
/*
 * Lesson 1.1: shell model of a copper atom (2, 8, 18 and 1 electrons). The
 * single electron of the last shell is the one that becomes a free electron
 * in the metal.
 */
import Figure from '../../../components/Figure.astro';

const CX = 165;
const CY = 165;
/** Electrons per shell and the shell radius in the drawing. */
const SHELLS = [
  { count: 2, r: 40, offset: 90 },
  { count: 8, r: 70, offset: 22.5 },
  { count: 18, r: 103, offset: 10 },
];
const OUTER_R = 140;
/** The free electron sits up and to the right, next to its label. */
const OUTER_ANGLE = -40;

const at = (r: number, deg: number) => {
  const rad = (deg * Math.PI) / 180;
  return { x: CX + r * Math.cos(rad), y: CY + r * Math.sin(rad) };
};

const inner = SHELLS.flatMap(({ count, r, offset }) =>
  Array.from({ length: count }, (_, i) => at(r, offset + (360 / count) * i)),
);
const outer = at(OUTER_R, OUTER_ANGLE);
const shell3 = at(103, 10);
---

<Figure
  wide
  alt="Modelo do átomo de cobre. No centro, o núcleo com 29 prótons e 34 nêutrons. Em volta, quatro camadas de elétrons: 2 na primeira, 8 na segunda, 18 na terceira e apenas 1 na quarta, mais afastada. Esse último elétron está destacado: preso fracamente, é ele que se solta e circula pelo metal como elétron livre."
  caption="Modelo de camadas do átomo de cobre, uma simplificação útil. São 29 elétrons em quatro camadas: 2, 8, 18 e 1. O elétron sozinho na última camada fica longe do núcleo e preso fracamente; num pedaço de cobre, ele se solta e vira um elétron livre. O desenho está fora de escala: o núcleo é dezenas de milhares de vezes menor que o átomo."
>
  <svg
    class="fig-atomo"
    viewBox="0 0 640 330"
    width="640"
    height="330"
    fill="none"
    font-family="var(--font-sans)"
    font-size="17"
  >
    <!-- Shells -->
    {[...SHELLS.map((s) => s.r), OUTER_R].map((r) => (
      <circle cx={CX} cy={CY} r={r} class="fig-atomo__shell" stroke-width="1.5" />
    ))}

    <!-- Nucleus -->
    <circle cx={CX} cy={CY} r="20" class="fig-atomo__nucleus"></circle>
    <text x={CX} y={CY + 5} text-anchor="middle" class="fig-atomo__nucleus-t">
      29+
    </text>

    <!-- Bound electrons -->
    {inner.map((p) => (
      <circle cx={p.x} cy={p.y} r="4.5" class="fig-atomo__electron" />
    ))}

    <!-- The free electron -->
    <circle cx={outer.x} cy={outer.y} r="12" class="fig-atomo__halo"></circle>
    <circle cx={outer.x} cy={outer.y} r="6.5" class="fig-atomo__free"></circle>

    <!-- Leader lines -->
    <path
      d={`M${outer.x + 14} ${outer.y}H352`}
      class="fig-atomo__leader"
      stroke-width="1.2"
      stroke-dasharray="3 4"
    ></path>
    <path
      d={`M${shell3.x + 8} ${shell3.y}H352`}
      class="fig-atomo__leader"
      stroke-width="1.2"
      stroke-dasharray="3 4"
    ></path>
    <path
      d={`M${CX + 18} ${CY + 10}L${CX + 60} 268H352`}
      class="fig-atomo__leader"
      stroke-width="1.2"
      stroke-dasharray="3 4"
    ></path>

    <!-- Labels -->
    <text x="362" y={outer.y - 4} class="fig-atomo__label fig-atomo__label--free">
      1 elétron na última camada
    </text>
    <text x="362" y={outer.y + 16} class="fig-atomo__small">
      preso fracamente: no metal,
    </text>
    <text x="362" y={outer.y + 35} class="fig-atomo__small">
      vira um elétron livre
    </text>

    <text x="362" y={shell3.y + 1} class="fig-atomo__label">
      2 + 8 + 18 elétrons
    </text>
    <text x="362" y={shell3.y + 21} class="fig-atomo__small">
      nas camadas de dentro,
    </text>
    <text x="362" y={shell3.y + 40} class="fig-atomo__small">
      bem presos ao núcleo
    </text>

    <text x="362" y="264" class="fig-atomo__label">
      núcleo
    </text>
    <text x="362" y="285" class="fig-atomo__small">
      29 prótons (+) e 34 nêutrons
    </text>
  </svg>
</Figure>

<style>
  .fig-atomo {
    color: var(--fg);
  }

  .fig-atomo text {
    fill: currentColor;
    stroke: none;
  }

  .fig-atomo__label {
    font-weight: 650;
  }

  .fig-atomo text.fig-atomo__label--free {
    fill: var(--accent);
  }

  .fig-atomo text.fig-atomo__small {
    fill: var(--fg-muted);
    font-size: 15px;
  }

  .fig-atomo__shell {
    stroke: var(--border-strong);
  }

  .fig-atomo__nucleus {
    fill: color-mix(in oklab, var(--danger) 22%, var(--bg));
    stroke: var(--danger);
    stroke-width: 1.5;
  }

  .fig-atomo text.fig-atomo__nucleus-t {
    fill: var(--danger);
    font-size: 13px;
    font-weight: 700;
  }

  .fig-atomo__electron {
    fill: var(--fg-muted);
  }

  .fig-atomo__free {
    fill: var(--accent);
  }

  .fig-atomo__halo {
    fill: color-mix(in oklab, var(--accent) 22%, transparent);
  }

  .fig-atomo__leader {
    stroke: var(--fg-subtle);
  }
</style>
