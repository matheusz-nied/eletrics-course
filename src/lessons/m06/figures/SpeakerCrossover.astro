---
/*
 * 06.6: a two-way speaker. The amplifier's signal reaches the crossover:
 * a coil in series with the woofer lets the bass through, a capacitor in
 * series with the tweeter lets the treble through. Front view of the box
 * on the left, the crossover drawn as a circuit on the right.
 */
const coil = 'a 9 9 0 0 1 18 0 '.repeat(4).trim();
---

<svg viewBox="0 0 640 300" width="640" height="300" class="fig" aria-hidden="true">
  <!-- The box, front view. -->
  <rect x="20" y="20" width="170" height="260" rx="10" class="box" />
  <circle cx="105" cy="76" r="26" class="cone" />
  <circle cx="105" cy="76" r="11" class="dome" />
  <circle cx="105" cy="190" r="66" class="cone" />
  <circle cx="105" cy="190" r="50" class="surround" />
  <circle cx="105" cy="190" r="20" class="dome" />
  <text x="105" y="120" class="lbl">
    tweeter
  </text>
  <text x="105" y="272" class="lbl">
    woofer
  </text>

  <!-- Input from the amplifier. -->
  <text x="236" y="40" class="sub start">
    do amplificador
  </text>
  <circle cx="246" cy="60" r="5" class="term" />
  <circle cx="246" cy="250" r="5" class="term" />
  <text x="232" y="64" class="lbl end">
    +
  </text>
  <text x="232" y="254" class="lbl end">
    −
  </text>

  <!-- Top branch: capacitor to the tweeter. -->
  <path d="M251 60 H330 V96 H380" class="wire" />
  <path d="M380 80 V112 M392 80 V112" class="part" />
  <path d="M392 96 H520 V112" class="wire" />
  <text x="386" y="72" class="sub">
    capacitor
  </text>
  <text x="424" y="132" class="note">
    deixa passar os agudos
  </text>

  <!-- Bottom branch: coil to the woofer. -->
  <path d="M330 96 V176 H372" class="wire" />
  <path d={`M372 176 ${coil}`} class="part" />
  <path d="M444 176 H560 V196" class="wire" />
  <text x="408" y="156" class="sub">
    bobina
  </text>
  <text x="408" y="206" class="note">
    deixa passar os graves
  </text>

  <!-- Speakers as symbols, and the return. -->
  <rect x="506" y="112" width="28" height="40" rx="4" class="spk" />
  <text x="544" y="137" class="lbl start">
    tweeter
  </text>
  <rect x="546" y="196" width="28" height="40" rx="4" class="spk" />
  <text x="584" y="221" class="lbl start">
    woofer
  </text>
  <path d="M520 152 V250 M560 236 V250 M251 250 H560" class="wire" />
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .box {
    fill: var(--surface-2);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .cone {
    fill: var(--fg-subtle);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .surround {
    stroke: var(--bg);
    stroke-width: 2;
  }
  .dome {
    fill: var(--fg-muted);
    stroke: var(--fg);
    stroke-width: 1.5;
  }
  .term {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .wire {
    stroke: var(--copper);
    stroke-width: 2.5;
  }
  .part {
    stroke: var(--fg);
    stroke-width: 3;
  }
  .spk {
    fill: var(--surface);
    stroke: var(--fg);
    stroke-width: 2;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 14px;
    text-anchor: middle;
  }
  .lbl {
    font-weight: 700;
  }
  .sub {
    fill: var(--fg-muted);
    font-size: 13px;
  }
  .note {
    fill: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }
  .start {
    text-anchor: start;
  }
  .end {
    text-anchor: end;
  }
</style>
