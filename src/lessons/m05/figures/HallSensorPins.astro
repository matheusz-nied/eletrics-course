---
/*
 * 05.5: a three-pin Hall switch (typical pin order) and how its open-collector
 * output is wired with a pull-up resistor.
 */
const legs = [
  { x: 64, n: '1', t: 'VCC' },
  { x: 100, n: '2', t: 'GND' },
  { x: 136, n: '3', t: 'saída' },
];
---

<svg viewBox="0 0 560 250" width="560" height="250" class="fig" aria-hidden="true">
  <!-- Package -->
  <text x="100" y="20" class="title">
    O sensor (ordem típica)
  </text>
  <path d="M32 52 L44 40 H156 L168 52 V112 H32 Z" class="body" />
  <text x="100" y="72" class="face">
    face marcada:
  </text>
  <text x="100" y="88" class="face">
    o ímã vem por aqui
  </text>
  {legs.map((l) => (
    <g>
      <path d={`M${l.x} 112 V184`} class="leg" />
      <text x={l.x} y="202" class="pin">
        {l.n}
      </text>
      <text x={l.x} y="220" class="small">
        {l.t}
      </text>
    </g>
  ))}
  <text x="100" y="242" class="note">
    Confira na folha de dados.
  </text>

  <!-- Wiring -->
  <text x="410" y="20" class="title">
    A ligação com pull-up
  </text>
  <path d="M300 46 H500" class="wire" />
  <text x="292" y="50" class="rail end">
    +5 V
  </text>
  <path d="M300 196 H500" class="wire" />
  <text x="292" y="200" class="rail end">
    0 V
  </text>
  <path d="M350 46 V90 M350 150 V196" class="wire" />
  <rect x="316" y="90" width="68" height="60" rx="4" class="ic" />
  <text x="350" y="118" class="ic-text">
    Hall
  </text>
  <text x="350" y="134" class="ic-small">
    saída aberta
  </text>
  <path d="M384 120 H500" class="wire" />
  <path
    d="M440 46 V62 L446 66 L434 72 L446 78 L434 84 L446 90 L434 96 L440 100 V120"
    class="wire"
  />
  <circle cx="440" cy="120" r="3" class="dot" />
  <circle cx="500" cy="120" r="4" class="term" />
  <text x="454" y="82" class="small start">
    pull-up
  </text>
  <text x="454" y="98" class="small start">
    10 kΩ
  </text>
  <text x="500" y="142" class="small">
    saída
  </text>
  <text x="410" y="222" class="note">
    Ímã perto: a saída vai a 0 V.
  </text>
  <text x="410" y="242" class="note">
    Ímã longe: o pull-up segura a saída em 5 V.
  </text>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .body {
    fill: var(--fg);
    stroke: var(--fg);
    stroke-width: 1;
  }
  .leg {
    stroke: var(--fg-subtle);
    stroke-width: 4;
  }
  .wire {
    stroke: var(--fg);
    stroke-width: 2;
  }
  .ic {
    fill: var(--surface-2);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .dot {
    fill: var(--fg);
  }
  .term {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 13px;
    text-anchor: middle;
  }
  .title {
    font-size: 14px;
    font-weight: 700;
  }
  .face {
    fill: var(--bg);
    font-size: 11.5px;
  }
  .pin {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }
  .small {
    font-size: 12px;
    fill: var(--fg-muted);
  }
  .rail {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }
  .ic-text {
    font-size: 14px;
    font-weight: 700;
  }
  .ic-small {
    font-size: 11px;
    fill: var(--fg-muted);
  }
  .note {
    font-size: 12.5px;
    fill: var(--fg-muted);
  }
  .start {
    text-anchor: start;
  }
  .end {
    text-anchor: end;
  }
</style>
