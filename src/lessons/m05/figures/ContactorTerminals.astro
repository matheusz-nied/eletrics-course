---
/*
 * 05.6: a generic contactor seen from the front, with the terminal numbers
 * printed next to each screw, and its schematic symbol. No maker's layout:
 * just the numbering every contactor shares (IEC 60947).
 */
const top = [
  { x: 44, t: 'A1' },
  { x: 84, t: '1/L1' },
  { x: 120, t: '3/L2' },
  { x: 156, t: '5/L3' },
  { x: 196, t: '13' },
  { x: 230, t: '21' },
];
const bottom = [
  { x: 44, t: 'A2' },
  { x: 84, t: '2/T1' },
  { x: 120, t: '4/T2' },
  { x: 156, t: '6/T3' },
  { x: 196, t: '14' },
  { x: 230, t: '22' },
];
const main = [
  { x: 360, a: '1', b: '2' },
  { x: 400, a: '3', b: '4' },
  { x: 440, a: '5', b: '6' },
];
const legend = [
  'A1 e A2: bobina',
  '1-2, 3-4, 5-6: contatos principais',
  '(L1 → T1, L2 → T2, L3 → T3)',
  '13-14: auxiliar NA (final 3-4)',
  '21-22: auxiliar NF (final 1-2)',
];
---

<svg viewBox="0 0 560 330" width="560" height="330" class="fig" aria-hidden="true">
  <!-- Front view -->
  <text x="44" y="16" class="group">
    bobina
  </text>
  <text x="120" y="16" class="group">
    contatos principais
  </text>
  <text x="213" y="16" class="group">
    auxiliares
  </text>
  <rect x="20" y="26" width="230" height="278" rx="10" class="body" />
  {top.map((p) => (
    <g>
      <text x={p.x} y="48" class="pin">
        {p.t}
      </text>
      <circle cx={p.x} cy="70" r="9" class="screw" />
      <path d={`M${p.x - 5} 70 H${p.x + 5}`} class="slot" />
    </g>
  ))}
  {bottom.map((p) => (
    <g>
      <circle cx={p.x} cy="256" r="9" class="screw" />
      <path d={`M${p.x - 5} 256 H${p.x + 5}`} class="slot" />
      <text x={p.x} y="288" class="pin">
        {p.t}
      </text>
    </g>
  ))}
  <rect x="58" y="112" width="154" height="96" rx="6" class="plate" />
  <text x="135" y="136" class="name">
    contator
  </text>
  <text x="135" y="158" class="small">
    bobina 220 V 60 Hz
  </text>
  <rect x="115" y="172" width="40" height="22" rx="3" class="window" />
  <text x="135" y="226" class="small">
    visor: mostra se atracou
  </text>
  <text x="44" y="320" class="group">
    bobina
  </text>
  <text x="120" y="320" class="group">
    para o motor
  </text>
  <text x="213" y="320" class="group">
    auxiliares
  </text>

  <!-- Symbol -->
  <path d="M310 56 V84 M310 120 V148" class="wire" />
  <rect x="298" y="84" width="24" height="36" class="coil" />
  <circle cx="310" cy="56" r="3.5" class="term" />
  <circle cx="310" cy="148" r="3.5" class="term" />
  <text x="318" y="52" class="pin start">
    A1
  </text>
  <text x="318" y="164" class="pin start">
    A2
  </text>
  <text x="292" y="106" class="name end">
    K1
  </text>
  {main.map((c) => (
    <g>
      <path d={`M${c.x} 56 V84 M${c.x} 148 V120 L${c.x - 13} 88`} class="contact main" />
      <circle cx={c.x} cy="56" r="3.5" class="term" />
      <circle cx={c.x} cy="148" r="3.5" class="term" />
      <text x={c.x + 8} y="52" class="pin start">
        {c.a}
      </text>
      <text x={c.x + 8} y="164" class="pin start">
        {c.b}
      </text>
    </g>
  ))}
  <path d="M490 56 V84 M490 148 V120 L477 88" class="contact" />
  <circle cx="490" cy="56" r="3.5" class="term" />
  <circle cx="490" cy="148" r="3.5" class="term" />
  <text x="498" y="52" class="pin start">
    13
  </text>
  <text x="498" y="164" class="pin start">
    14
  </text>
  <path d="M532 56 V86 H541 M532 148 V120 L543 82" class="contact" />
  <circle cx="532" cy="56" r="3.5" class="term" />
  <circle cx="532" cy="148" r="3.5" class="term" />
  <text x="540" y="52" class="pin start">
    21
  </text>
  <text x="540" y="164" class="pin start">
    22
  </text>
  <path d="M322 104 H537" class="link" />
  <text x="420" y="186" class="small">
    tracejado: tudo muda junto
  </text>
  {legend.map((l, i) => (
    <text x={i === 2 ? 306 : 292} y={220 + i * 20} class={i === 2 ? 'legend indent' : 'legend'}>
      {l}
    </text>
  ))}
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .body {
    fill: var(--surface);
    stroke: var(--fg-muted);
    stroke-width: 2;
  }
  .screw {
    fill: var(--surface-2);
    stroke: var(--fg);
    stroke-width: 1.5;
  }
  .slot {
    stroke: var(--fg);
    stroke-width: 2;
  }
  .plate {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .window {
    fill: color-mix(in oklab, var(--info) 12%, transparent);
    stroke: var(--fg-muted);
    stroke-width: 1.2;
  }
  .wire {
    stroke: var(--fg);
    stroke-width: 2;
  }
  .coil {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .contact {
    stroke: var(--fg);
    stroke-width: 2;
  }
  .contact.main {
    stroke: var(--copper);
    stroke-width: 3;
  }
  .term {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 1.5;
  }
  .link {
    stroke: var(--fg-subtle);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 13px;
    text-anchor: middle;
  }
  .pin {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }
  .group {
    font-size: 11.5px;
    fill: var(--fg-muted);
  }
  .name {
    font-size: 14px;
    font-weight: 700;
  }
  .small {
    font-size: 11.5px;
    fill: var(--fg-muted);
  }
  .legend {
    font-size: 13px;
    text-anchor: start;
  }
  .indent {
    fill: var(--fg-muted);
  }
  .start {
    text-anchor: start;
  }
  .end {
    text-anchor: end;
  }
</style>
