---
/*
 * 05.4: a small EI transformer taken apart (the SVG behind <Part3D
 * part="transformer-ei"> until the 3D part exists). Front view: the E sheets,
 * the bobbin cut open (primary inside, secondary outside) and the I sheets;
 * on the right, the stack of thin varnished sheets and an example label.
 */
const sheets = Array.from({ length: 9 }, (_, i) => 52 + i * 11);
const label = ['Primário: 0 – 127 – 220 V', 'Secundário: 12 V – 1,25 A', 'Potência: 15 VA'];
---

<svg viewBox="0 0 560 360" width="560" height="360" class="fig" aria-hidden="true">
  <text x="160" y="20" class="lbl">
    chapas em E
  </text>
  <path d="M60 30 H260 V130 H230 V60 H185 V130 H135 V60 H90 V130 H60 Z" class="iron" />

  <rect x="92" y="150" width="136" height="6" class="flange" />
  <rect x="92" y="224" width="136" height="6" class="flange" />
  <rect x="135" y="156" width="50" height="68" class="hole" />
  <rect x="100" y="156" width="17" height="68" class="secondary" />
  <rect x="119" y="156" width="14" height="68" class="primary" />
  <rect x="187" y="156" width="14" height="68" class="primary" />
  <rect x="203" y="156" width="17" height="68" class="secondary" />
  <text x="160" y="194" class="small">
    perna
  </text>
  <text x="160" y="208" class="small">
    central
  </text>

  <path d="M100 170 H44 M100 186 H44 M100 202 H44" class="lead" />
  <text x="38" y="174" class="pin">
    220
  </text>
  <text x="38" y="190" class="pin">
    127
  </text>
  <text x="38" y="206" class="pin">
    0
  </text>
  <path d="M220 180 H292 M220 200 H292" class="lead thick" />
  <text x="298" y="194" class="pin start">
    12 V
  </text>

  <path d="M60 250 H260 V280 H60 Z" class="iron" />
  <text x="160" y="300" class="lbl">
    chapas em I
  </text>

  <rect x="40" y="316" width="14" height="10" class="primary" />
  <text x="60" y="325" class="small start">
    primário: fio fino, por dentro
  </text>
  <rect x="40" y="334" width="14" height="10" class="secondary" />
  <text x="60" y="343" class="small start">
    secundário: fio grosso, por fora
  </text>

  <text x="445" y="34" class="lbl">
    o núcleo de lado
  </text>
  {sheets.map((y) => (
    <rect x="370" y={y} width="150" height="8" class="sheet" />
  ))}
  <path d="M528 52 V149" class="brace" />
  <text x="445" y="168" class="small">
    chapas finas, separadas
  </text>
  <text x="445" y="183" class="small">
    por verniz isolante
  </text>

  <rect x="350" y="214" width="190" height="84" rx="4" class="tag" />
  <text x="445" y="234" class="tag-title">
    ETIQUETA (exemplo)
  </text>
  {label.map((line, i) => (
    <text x="362" y={256 + i * 17} class="tag-line">
      {line}
    </text>
  ))}
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .iron {
    fill: color-mix(in oklab, var(--fg-subtle) 40%, transparent);
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .flange {
    fill: var(--surface-2);
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .hole {
    fill: var(--bg);
    stroke: var(--border-strong);
    stroke-dasharray: 4 3;
  }
  .primary {
    fill: color-mix(in oklab, var(--copper) 35%, var(--surface));
    stroke: var(--copper);
    stroke-width: 1;
  }
  .secondary {
    fill: color-mix(in oklab, var(--copper) 75%, var(--surface));
    stroke: var(--copper);
    stroke-width: 1;
  }
  .lead {
    stroke: var(--copper);
    stroke-width: 1.5;
  }
  .lead.thick {
    stroke-width: 3;
  }
  .sheet {
    fill: color-mix(in oklab, var(--fg-subtle) 45%, transparent);
    stroke: var(--fg-muted);
    stroke-width: 0.8;
  }
  .brace {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .tag {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 13px;
    text-anchor: middle;
  }
  .lbl {
    fill: var(--fg-muted);
    font-weight: 600;
  }
  .small {
    fill: var(--fg-muted);
    font-size: 12px;
  }
  .pin {
    fill: var(--fg-muted);
    font-size: 12px;
    font-weight: 700;
    text-anchor: end;
  }
  .start {
    text-anchor: start;
  }
  .tag-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .tag-line {
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-anchor: start;
  }
</style>
