---
/*
 * 04.3: an aluminium electrolytic capacitor. By default, the outside (negative
 * stripe, longer positive lead, vent) and the layers of the roll inside. With
 * `bulged`, a good capacitor next to a bulged one with the vent open.
 */
export interface Props {
  bulged?: boolean;
}

const { bulged = false } = Astro.props;

const cans = bulged
  ? [
      { x: 110, bad: false, title: 'bom: topo reto' },
      { x: 360, bad: true, title: 'estufado: topo abaulado' },
    ]
  : [{ x: 40, bad: false, title: '' }];

// The paper, foils and electrolyte are wound into a roll: an Archimedean spiral.
const spiral = (() => {
  const turns = 3.25;
  const n = 160;
  const pts: string[] = [];
  for (let i = 0; i <= n; i++) {
    const a = (i / n) * turns * 2 * Math.PI;
    const r = 4 + (32 * i) / n;
    pts.push(`${(345 + r * Math.cos(a)).toFixed(1)} ${(235 + r * Math.sin(a)).toFixed(1)}`);
  }
  return `M${pts.join(' L')}`;
})();

const layers = [
  { y: 46, kind: 'paper', label: 'papel com eletrólito' },
  { y: 80, kind: 'anode', label: 'alumínio do anodo (+)' },
  { y: 114, kind: 'paper', label: 'papel com eletrólito' },
  { y: 148, kind: 'cathode', label: 'alumínio do catodo (−)' },
];
---

<svg viewBox="0 0 560 312" width="560" height="312" class="fig" aria-hidden="true">
  {cans.map((c) => (
    <g transform={`translate(${c.x} 0)`}>
      <path d="M25 210 V285 M65 210 V260" class="lead" />
      <path d="M0 48 V200 A45 12 0 0 0 90 200 V48 Z" class="sleeve" />
      <path d="M60 48 V211 Q77 207 90 200 V48 Z" class="stripe" />
      {[90, 120, 150, 180].map((y) => (
        <text x="75" y={y} class="minus">
          −
        </text>
      ))}
      <text x="28" y="124" class="mark" transform="rotate(-90 28 124)">
        1.000 µF 16 V
      </text>
      <text x="46" y="124" class="mark" transform="rotate(-90 46 124)">
        105 °C
      </text>
      {c.bad ? (
        <>
          <path d="M0 48 C8 18 82 18 90 48 A45 12 0 0 1 0 48 Z" class="top" />
          <path d="M30 38 L42 36 M48 35 L62 38 M45 28 L44 34 M45 40 L46 46" class="vent" />
          <circle cx="44" cy="36" r="4" class="crust" />
          <circle cx="56" cy="31" r="3" class="crust" />
          <circle cx="33" cy="42" r="2.5" class="crust" />
        </>
      ) : (
        <>
          <ellipse cx="45" cy="48" rx="45" ry="12" class="top" />
          <path d="M28 48 H62 M45 43 V53" class="vent" />
        </>
      )}
      {c.title && (
        <text x="45" y="12" class="lbl">
          {c.title}
        </text>
      )}
    </g>
  ))}

  {bulged ? (
    <>
      <path d="M410 34 L462 60" class="leader" />
      <text x="466" y="64" class="small start">
        respiro aberto
      </text>
      <path d="M418 40 L462 92" class="leader" />
      <text x="466" y="96" class="small start">
        crosta de
      </text>
      <text x="466" y="112" class="small start">
        eletrólito
      </text>
      <text x="405" y="304" class="small">
        troque, mesmo que ainda funcione
      </text>
    </>
  ) : (
    <>
      <path d="M95 42 L150 28" class="leader" />
      <text x="155" y="32" class="small start">
        respiro: vinco no topo
      </text>
      <path d="M130 120 L150 120" class="leader" />
      <text x="155" y="124" class="small start">
        faixa do negativo
      </text>
      <text x="115" y="256" class="small start">
        perna curta (−)
      </text>
      <path d="M68 279 L111 279" class="leader" />
      <text x="115" y="283" class="small start">
        perna longa (+)
      </text>

      <text x="425" y="24" class="lbl">
        Por dentro, desenrolado
      </text>
      {layers.map((l) => (
        <>
          <rect x="300" y={l.y} width="90" height="14" rx="2" class={l.kind} />
          {l.kind === 'anode' && <rect x="300" y={l.y - 3} width="90" height="3" class="oxide" />}
          <text x="402" y={l.y + 11} class="small start">
            {l.label}
          </text>
        </>
      ))}
      <text x="402" y="105" class="tiny start">
        com óxido: o dielétrico
      </text>
      <path d={spiral} class="roll" />
      <text x="392" y="228" class="small start">
        tudo é enrolado,
      </text>
      <text x="392" y="246" class="small start">
        molhado de eletrólito
      </text>
      <text x="392" y="264" class="small start">
        e fechado na lata
      </text>
    </>
  )}
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lead {
    stroke: var(--fg-subtle);
    stroke-width: 3;
  }
  .sleeve {
    fill: color-mix(in oklab, var(--accent) 45%, var(--surface));
    stroke: var(--accent);
  }
  .stripe {
    fill: color-mix(in oklab, var(--accent) 12%, var(--surface));
    stroke: none;
  }
  .top {
    fill: color-mix(in oklab, var(--fg-subtle) 35%, var(--surface));
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .vent {
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .crust {
    fill: color-mix(in oklab, var(--copper) 70%, var(--surface));
    stroke: var(--copper);
    stroke-width: 1;
  }
  .leader {
    stroke: var(--fg-subtle);
    stroke-width: 1.2;
  }
  .paper {
    fill: color-mix(in oklab, var(--warning) 30%, var(--surface));
    stroke: var(--warning);
    stroke-width: 1;
  }
  .anode,
  .cathode {
    fill: color-mix(in oklab, var(--fg-subtle) 45%, var(--surface));
    stroke: var(--fg-muted);
    stroke-width: 1;
  }
  .oxide {
    fill: var(--danger);
    stroke: none;
  }
  .roll {
    stroke: var(--fg-muted);
    stroke-width: 1.6;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 14px;
    text-anchor: middle;
  }
  .lbl {
    font-weight: 700;
    font-size: 15px;
  }
  .minus {
    font-weight: 700;
    font-size: 16px;
  }
  .mark {
    font-size: 12px;
    font-weight: 600;
    fill: var(--fg);
  }
  .small {
    font-size: 12.5px;
    fill: var(--fg-muted);
  }
  .tiny {
    font-size: 11.5px;
    fill: var(--danger);
  }
  .start {
    text-anchor: start;
  }
</style>
