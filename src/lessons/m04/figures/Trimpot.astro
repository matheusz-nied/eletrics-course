---
/*
 * 04.2: the two trimpots the lesson describes, as the illustration of
 * <Part3D part="trimpot"> until the 3D part is available. "aberto": an open
 * single-turn carbon trimmer seen from above (two pins in front, the wiper
 * pin behind). "multivoltas": a sealed multi-turn trimmer seen from the side,
 * with the worm screw and the gear that carries the wiper drawn through the
 * case. Generic drawings, no brand.
 */
export interface Props {
  variant: 'aberto' | 'multivoltas';
}

const { variant } = Astro.props;
---

{variant === 'aberto' ? (
  <svg viewBox="0 0 520 260" width="520" height="260" class="fig" aria-hidden="true">
    <rect x="40" y="30" width="190" height="190" rx="10" class="base" />
    <path d="M104 178.7 A62 62 0 1 1 166 178.7" class="track" />
    <circle cx="135" cy="125" r="50" class="rotor" />
    <path d="M135 95V155M105 125H165" class="slot" />
    <rect x="128" y="8" width="14" height="22" class="pin" />
    <rect x="58" y="220" width="14" height="24" class="pin" />
    <rect x="198" y="220" width="14" height="24" class="pin" />
    <text x="135" y="212" class="print">
      103
    </text>
    <g class="leader">
      <path d="M168 110 L300 60" />
      <path d="M197 150 L300 128" />
      <path d="M212 232 L300 196" />
      <path d="M142 19 L300 30" />
    </g>
    <text x="306" y="56" class="lbl">
      Rotor com fenda
    </text>
    <text x="306" y="74" class="small">
      gira com chave de fenda
    </text>
    <text x="306" y="124" class="lbl">
      Pista de carbono
    </text>
    <text x="306" y="142" class="small">
      aparece pelas bordas
    </text>
    <text x="306" y="192" class="lbl">
      Pontas da pista
    </text>
    <text x="306" y="210" class="small">
      os 2 pinos da frente
    </text>
    <text x="306" y="26" class="lbl">
      Cursor: pino de trás
    </text>
  </svg>
) : (
  <svg viewBox="0 0 520 260" width="520" height="260" class="fig" aria-hidden="true">
    <rect x="70" y="20" width="26" height="22" rx="3" class="brass" />
    <path d="M75 26H91" class="brass-slot" />
    <rect x="40" y="40" width="200" height="160" rx="6" class="case" />
    <path d="M72 50V150" class="worm-axis" />
    <path
      d="M62 58 L82 66 M62 70 L82 78 M62 82 L82 90 M62 94 L82 102 M62 106 L82 114 M62 118 L82 126 M62 130 L82 138"
      class="worm"
    />
    <path d="M96.7 75 A50 50 0 0 1 189.2 91.3" class="track" />
    <circle cx="140" cy="100" r="36" class="gear" />
    <path d="M140 100 L182 73" class="wiper" />
    <text x="140" y="190" class="print light">
      103
    </text>
    <rect x="86" y="200" width="10" height="38" class="pin" />
    <rect x="135" y="200" width="10" height="38" class="pin" />
    <rect x="184" y="200" width="10" height="38" class="pin" />
    <g class="leader">
      <path d="M96 30 L300 30" />
      <path d="M82 96 L300 92" />
      <path d="M160 118 L300 150" />
      <path d="M194 225 L300 214" />
    </g>
    <text x="306" y="26" class="lbl">
      Parafuso de ajuste
    </text>
    <text x="306" y="44" class="small">
      25 voltas para o curso todo (típico)
    </text>
    <text x="306" y="88" class="lbl">
      Parafuso sem fim
    </text>
    <text x="306" y="106" class="small">
      empurra a engrenagem devagar
    </text>
    <text x="306" y="146" class="lbl">
      Engrenagem com o cursor
    </text>
    <text x="306" y="164" class="small">
      o cursor anda sobre a pista
    </text>
    <text x="306" y="210" class="lbl">
      3 pinos em linha
    </text>
    <text x="306" y="228" class="small">
      ponta, cursor, ponta
    </text>
  </svg>
)}

<style>
  .fig {
    font-family: var(--font-sans);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .base {
    fill: #f0eee6;
    stroke: #9a978c;
    stroke-width: 2;
  }
  .track {
    fill: none;
    stroke: #2a2422;
    stroke-width: 14;
    stroke-linecap: butt;
  }
  .rotor {
    fill: #fafafa;
    stroke: #8a8a8a;
    stroke-width: 2;
  }
  .slot {
    stroke: #8a8a8a;
    stroke-width: 7;
  }
  .pin {
    fill: #b9bcc0;
    stroke: #7d8186;
    stroke-width: 1;
  }
  .case {
    fill: color-mix(in oklab, #2f6fbf 75%, transparent);
    stroke: #1f4f8f;
    stroke-width: 2;
  }
  .brass {
    fill: #c9a24a;
    stroke: #8f7128;
    stroke-width: 1.5;
  }
  .brass-slot {
    stroke: #6f561c;
    stroke-width: 3;
  }
  .worm-axis {
    stroke: #e8e8e8;
    stroke-width: 3;
    opacity: 0.8;
  }
  .worm {
    stroke: #e8e8e8;
    stroke-width: 3;
  }
  .gear {
    fill: none;
    stroke: #e8e8e8;
    stroke-width: 6;
    stroke-dasharray: 5 4;
  }
  .wiper {
    stroke: #d8b25a;
    stroke-width: 5;
  }
  .print {
    fill: #444;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    text-anchor: middle;
  }
  .light {
    fill: #f2f2f2;
  }
  .leader {
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }
  text {
    fill: var(--fg);
    font-size: 15px;
  }
  .lbl {
    font-weight: 600;
  }
  .small {
    fill: var(--fg-muted);
    font-size: 13px;
  }
</style>
