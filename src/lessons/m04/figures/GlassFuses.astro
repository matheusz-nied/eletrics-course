---
/*
 * 04.6: three 5 × 20 mm glass fuses: fast (thin straight element), time-lag
 * (element wound in a spiral) and blown (element broken, glass darkened).
 */
const coil = Array.from({ length: 14 }, (_, i) => {
  const x = -84 + i * 12;
  return `M${x} 6 C${x + 3} -9 ${x + 9} -9 ${x + 12} 6`;
}).join(' ');
---

<svg viewBox="0 0 560 330" width="560" height="330" class="fig" aria-hidden="true">
  <g transform="translate(280 52)">
    <rect x="-100" y="-20" width="200" height="40" rx="6" class="glass" />
    <path d="M-100 0 H100" class="element fast" />
    <rect x="-140" y="-23" width="44" height="46" rx="5" class="cap" />
    <rect x="96" y="-23" width="44" height="46" rx="5" class="cap" />
    <text x="-118" y="5" class="mark">
      F
    </text>
    <text x="0" y="48">
      Rápido (F): fio fino e reto
    </text>
  </g>

  <g transform="translate(280 152)">
    <rect x="-100" y="-20" width="200" height="40" rx="6" class="glass" />
    <path d="M-100 0 H-84" class="element" />
    <path d={coil} class="element slow" />
    <path d="M84 6 V0 H100" class="element" />
    <rect x="-140" y="-23" width="44" height="46" rx="5" class="cap" />
    <rect x="96" y="-23" width="44" height="46" rx="5" class="cap" />
    <text x="-118" y="5" class="mark">
      T
    </text>
    <text x="0" y="48">
      Retardado (T): elo enrolado, com mais massa
    </text>
  </g>

  <g transform="translate(280 252)">
    <rect x="-100" y="-20" width="200" height="40" rx="6" class="glass burnt" />
    <path d="M-100 0 H-14 M100 0 H16" class="element fast" />
    <circle cx="-14" cy="0" r="3" class="blob" />
    <circle cx="16" cy="0" r="3" class="blob" />
    <rect x="-140" y="-23" width="44" height="46" rx="5" class="cap" />
    <rect x="96" y="-23" width="44" height="46" rx="5" class="cap" />
    <text x="0" y="48">
      Queimado: elo rompido, vidro escurecido
    </text>
  </g>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .glass {
    fill: color-mix(in oklab, var(--info) 8%, transparent);
    stroke: var(--fg-subtle);
    stroke-width: 1.5;
  }
  .burnt {
    fill: color-mix(in oklab, var(--fg) 22%, transparent);
  }
  .cap {
    fill: color-mix(in oklab, var(--fg-subtle) 45%, var(--bg));
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }
  .element {
    stroke: var(--copper);
    stroke-width: 2;
  }
  .fast {
    stroke-width: 1.5;
  }
  .slow {
    stroke-width: 2.2;
  }
  .blob {
    fill: var(--copper);
    stroke: none;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 15px;
    text-anchor: middle;
  }
  .mark {
    font-size: 14px;
    font-weight: 700;
    fill: var(--fg);
  }
</style>
