---
/*
 * 08.3: the nameplate of a generic 1 CV, 4-pole, 220/380 V three-phase
 * motor (no brand), with the fields the lesson reads: power, voltages and
 * currents, speed, frequency, the efficiency, the power factor, Ip/In, the
 * service factor, the insulation class, the protection degree and the
 * connection diagram for each voltage.
 */
const rows: [string, string, string, string][] = [
  ['CV', '1', 'kW', '0,75'],
  ['V', '220/380', 'A', '3,02/1,75'],
  ['Hz', '60', 'rpm', '1.720'],
  ['η', '82,5 %', 'cos φ', '0,79'],
  ['Ip/In', '6,8', 'FS', '1,15'],
  ['Isol.', 'F', 'IP', '55'],
  ['Carc.', '80', 'Regime', 'S1'],
];
---

<svg viewBox="0 0 560 330" width="560" height="330" class="fig" aria-hidden="true">
  <rect x="10" y="10" width="540" height="310" rx="14" class="plate" />
  <circle cx="30" cy="30" r="5" class="rivet" />
  <circle cx="530" cy="30" r="5" class="rivet" />
  <circle cx="30" cy="300" r="5" class="rivet" />
  <circle cx="530" cy="300" r="5" class="rivet" />
  <text x="280" y="44" class="head">
    MOTOR DE INDUÇÃO TRIFÁSICO
  </text>
  <text x="280" y="64" class="small">
    rotor de gaiola · nº de série 000000
  </text>
  {rows.map((r, i) => (
    <g transform={`translate(0 ${86 + i * 30})`}>
      <rect x="40" y="0" width="166" height="24" rx="3" class="cell" />
      <rect x="216" y="0" width="166" height="24" rx="3" class="cell" />
      <text x="50" y="17" class="key">
        {r[0]}
      </text>
      <text x="196" y="17" class="val">
        {r[1]}
      </text>
      <text x="226" y="17" class="key">
        {r[2]}
      </text>
      <text x="372" y="17" class="val">
        {r[3]}
      </text>
    </g>
  ))}
  <g transform="translate(400 86)">
    <rect x="0" y="0" width="122" height="204" rx="4" class="cell" />
    <text x="61" y="22" class="key mid">
      220 V Δ
    </text>
    <g transform="translate(16 32)">
      {[0, 1, 2].map((k) => (
        <path d={`M${15 + k * 30} 12 V48`} class="bar" />
      ))}
      {[6, 4, 5].map((n, k) => (
        <g>
          <circle cx={15 + k * 30} cy="12" r="9" class="term" />
          <text x={15 + k * 30} y="16" class="tn">
            {n}
          </text>
        </g>
      ))}
      {[1, 2, 3].map((n, k) => (
        <g>
          <circle cx={15 + k * 30} cy="48" r="9" class="term" />
          <text x={15 + k * 30} y="52" class="tn">
            {n}
          </text>
        </g>
      ))}
    </g>
    <text x="61" y="118" class="key mid">
      380 V Y
    </text>
    <g transform="translate(16 128)">
      <path d="M15 12 H75" class="bar" />
      {[6, 4, 5].map((n, k) => (
        <g>
          <circle cx={15 + k * 30} cy="12" r="9" class="term" />
          <text x={15 + k * 30} y="16" class="tn">
            {n}
          </text>
        </g>
      ))}
      {[1, 2, 3].map((n, k) => (
        <g>
          <circle cx={15 + k * 30} cy="48" r="9" class="term" />
          <text x={15 + k * 30} y="52" class="tn">
            {n}
          </text>
        </g>
      ))}
    </g>
  </g>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
  }
  .plate {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 2;
  }
  .rivet {
    fill: var(--border-strong);
  }
  .cell {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1;
  }
  .term {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 1.5;
  }
  .bar {
    stroke: var(--copper);
    stroke-width: 6;
    stroke-linecap: round;
  }
  text {
    fill: var(--fg);
    font-size: 13px;
  }
  .head {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-anchor: middle;
  }
  .small {
    fill: var(--fg-muted);
    font-size: 11.5px;
    text-anchor: middle;
  }
  .key {
    fill: var(--fg-muted);
    font-weight: 700;
  }
  .mid {
    text-anchor: middle;
    fill: var(--fg);
  }
  .val {
    font-family: var(--font-mono);
    font-weight: 700;
    text-anchor: end;
  }
  .tn {
    font-size: 10.5px;
    font-weight: 700;
    text-anchor: middle;
  }
</style>
