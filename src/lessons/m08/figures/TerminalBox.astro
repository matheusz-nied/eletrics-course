---
/*
 * 08.3: the six terminals of a 220/380 V three-phase motor, as in most
 * Brazilian terminal boxes (top row 6 4 5, bottom row 1 2 3; winding 1–4,
 * 2–5 and 3–6), with the jumpers of delta (three vertical bars, 6–1, 4–2,
 * 5–3) and of star (one bar across 6–4–5), the lines on 1, 2 and 3, and
 * under each box the same connection drawn as a schematic.
 */
const top = [6, 4, 5];
const bottom = [1, 2, 3];
const XS = [60, 130, 200];
const Y_TOP = 66;
const Y_BOT = 128;

/** A winding as a small coil box between two points, with its end numbers. */
function coil(x1: number, y1: number, x2: number, y2: number) {
  const mx = (x1 + x2) / 2;
  const my = (y1 + y2) / 2;
  const angle = (Math.atan2(y2 - y1, x2 - x1) * 180) / Math.PI;
  return { mx, my, angle };
}

// Delta schematic: L1 on top, L2 bottom left, L3 bottom right.
const CENTROID = [150, (236 + 330 + 330) / 3] as const;
/** A point `f` of the way from a to b, pushed 13 px away from the triangle's centre. */
function outside(a: readonly number[], b: readonly number[], f: number) {
  const x = a[0]! + (b[0]! - a[0]!) * f;
  const y = a[1]! + (b[1]! - a[1]!) * f;
  const dx = x - CENTROID[0];
  const dy = y - CENTROID[1];
  const len = Math.hypot(dx, dy);
  return { x: x + (dx / len) * 13, y: y + (dy / len) * 13 + 4 };
}
const D = { l1: [150, 236], l2: [96, 330], l3: [204, 330] } as const;
const deltaSides = [
  { a: D.l1, b: D.l2, ends: ['1', '4'] },
  { a: D.l2, b: D.l3, ends: ['2', '5'] },
  { a: D.l3, b: D.l1, ends: ['3', '6'] },
].map((s) => ({
  ...s,
  c: coil(s.a[0], s.a[1], s.b[0], s.b[1]),
  labels: [0.2, 0.8].map((f) => outside(s.a, s.b, f)),
}));

// Star schematic: centre point with three arms.
const S = { c: [150, 290], l1: [150, 232], l2: [100, 320], l3: [200, 320] } as const;
const starArms = [
  { out: S.l1, ends: ['1', '4'] },
  { out: S.l2, ends: ['2', '5'] },
  { out: S.l3, ends: ['3', '6'] },
].map((a) => ({ ...a, c: coil(a.out[0], a.out[1], S.c[0], S.c[1]) }));
---

<svg viewBox="0 0 660 380" width="660" height="380" class="fig" aria-hidden="true">
  {
    ['delta', 'star'].map((kind, panel) => (
      <g transform={`translate(${panel * 340 + 10} 0)`}>
        <text x="130" y="20" class="title">
          {kind === 'delta' ? 'Triângulo (Δ): rede de 220 V' : 'Estrela (Y): rede de 380 V'}
        </text>
        <rect x="20" y="36" width="220" height="130" rx="10" class="box" />
        {kind === 'delta' &&
          XS.map((x) => <path d={`M${x} ${Y_TOP} V${Y_BOT}`} class="jumper" />)}
        {kind === 'star' && <path d={`M${XS[0]} ${Y_TOP} H${XS[2]}`} class="jumper" />}
        {XS.map((x, i) => (
          <g>
            <circle cx={x} cy={Y_TOP} r="11" class="terminal" />
            <text x={x} y={Y_TOP + 4.5} class="num">
              {top[i]}
            </text>
            <circle cx={x} cy={Y_BOT} r="11" class="terminal" />
            <text x={x} y={Y_BOT + 4.5} class="num">
              {bottom[i]}
            </text>
            <path d={`M${x} ${Y_BOT + 11} V${190}`} class="line" />
            <text x={x} y="206" class="line-t">
              L{i + 1}
            </text>
          </g>
        ))}
      </g>
    ))
  }

  <g transform="translate(10 0)">
    <path d={`M${D.l1[0]} ${D.l1[1]} L${D.l2[0]} ${D.l2[1]} L${D.l3[0]} ${D.l3[1]} Z`} class="wire" />
    {
      deltaSides.map((s) => (
        <g>
          <rect
            x={s.c.mx - 17}
            y={s.c.my - 7}
            width="34"
            height="14"
            rx="3"
            class="coil"
            transform={`rotate(${s.c.angle} ${s.c.mx} ${s.c.my})`}
          />
          {s.labels.map((l, k) => (
            <text x={l.x} y={l.y} class="end">
              {s.ends[k]}
            </text>
          ))}
        </g>
      ))
    }
    <circle cx={D.l1[0]} cy={D.l1[1]} r="3.5" class="node" />
    <circle cx={D.l2[0]} cy={D.l2[1]} r="3.5" class="node" />
    <circle cx={D.l3[0]} cy={D.l3[1]} r="3.5" class="node" />
    <text x={D.l1[0]} y={D.l1[1] - 9} class="line-t">L1</text>
    <text x={D.l2[0] - 12} y={D.l2[1] + 5} class="line-t right">L2</text>
    <text x={D.l3[0] + 12} y={D.l3[1] + 5} class="line-t left">L3</text>
    <text x="150" y="362" class="note">cada bobina fica entre duas fases: 220 V</text>
  </g>

  <g transform="translate(350 0)">
    {
      starArms.map((a) => (
        <g>
          <path d={`M${a.out[0]} ${a.out[1]} L${S.c[0]} ${S.c[1]}`} class="wire" />
          <rect
            x={a.c.mx - 15}
            y={a.c.my - 7}
            width="30"
            height="14"
            rx="3"
            class="coil"
            transform={`rotate(${a.c.angle} ${a.c.mx} ${a.c.my})`}
          />
          <circle cx={a.out[0]} cy={a.out[1]} r="3.5" class="node" />
        </g>
      ))
    }
    <circle cx={S.c[0]} cy={S.c[1]} r="4" class="node" />
    <text x={S.l1[0] + 14} y={S.l1[1] + 14} class="end">1</text>
    <text x={S.c[0] + 14} y={S.c[1] - 12} class="end">4</text>
    <text x={S.l2[0] - 4} y={S.l2[1] - 14} class="end">2</text>
    <text x={S.c[0] - 22} y={S.c[1] + 4} class="end">5</text>
    <text x={S.l3[0] + 4} y={S.l3[1] - 14} class="end">3</text>
    <text x={S.c[0] + 20} y={S.c[1] + 16} class="end">6</text>
    <text x={S.l1[0]} y={S.l1[1] - 9} class="line-t">L1</text>
    <text x={S.l2[0] - 12} y={S.l2[1] + 5} class="line-t right">L2</text>
    <text x={S.l3[0] + 12} y={S.l3[1] + 5} class="line-t left">L3</text>
    <text x="150" y="362" class="note">cada bobina recebe 380 ÷ √3 = 220 V</text>
  </g>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .box {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  .terminal {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .jumper {
    stroke: var(--copper);
    stroke-width: 9;
    opacity: 0.85;
  }
  .line {
    stroke: var(--fg);
    stroke-width: 2;
  }
  .wire {
    stroke: var(--fg);
    stroke-width: 1.75;
  }
  .coil {
    fill: var(--surface);
    stroke: var(--copper);
    stroke-width: 2.5;
  }
  .node {
    fill: var(--fg);
    stroke: none;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 13px;
    text-anchor: middle;
  }
  .title {
    font-size: 14px;
    font-weight: 700;
  }
  .num {
    font-size: 13px;
    font-weight: 700;
  }
  .line-t {
    font-size: 13px;
    font-weight: 700;
    fill: var(--accent);
  }
  .end {
    fill: var(--copper);
    font-size: 12px;
    font-weight: 700;
  }
  .note {
    fill: var(--fg-muted);
    font-size: 12px;
  }
  .right {
    text-anchor: end;
  }
  .left {
    text-anchor: start;
  }
</style>
