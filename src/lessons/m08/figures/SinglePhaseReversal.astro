---
/*
 * 08.4: two ways to reverse a single-phase capacitor motor. Left, a gate or
 * ceiling fan motor with two equal windings and three wires: the switch
 * puts the phase on one winding or the other, and the capacitor stays
 * between them. Right, a four-wire motor with a main and an auxiliary
 * winding: the main stays as it is and the two ends of the auxiliary
 * (with its capacitor) are swapped.
 */
const bumps = (x: number, y: number, n = 4) => `M${x} ${y}${' a8 8 0 0 1 16 0'.repeat(n)}`;
const vbumps = (x: number, y: number, n = 4) => `M${x} ${y}${' a8 8 0 0 1 0 16'.repeat(n)}`;
---

<svg viewBox="0 0 660 310" width="660" height="310" class="fig" aria-hidden="true">
  <text x="160" y="22" class="title">3 fios, enrolamentos iguais</text>
  <text x="160" y="40" class="sub">(portão, ventilador de teto)</text>
  <path d="M30 90 H80" class="wire" />
  <text x="30" y="82" class="lbl start">fase</text>
  <circle cx="80" cy="90" r="3.5" class="node" />
  <path d="M80 90 L117 72" class="switch" />
  <circle cx="120" cy="70" r="3.5" class="node" />
  <circle cx="120" cy="94" r="3.5" class="node" />
  <text x="72" y="126" class="small">chave de sentido</text>
  <path d="M120 70 H150 V100 H170" class="wire" />
  <path d="M120 94 H135 V180 H170" class="wire" />
  <path d={bumps(170, 100)} class="coil" />
  <path d={bumps(170, 180)} class="coil" />
  <path d="M150 100 V134 M150 146 V180" class="wire" />
  <path d="M138 134 H162 M138 146 H162" class="cap" />
  <circle cx="150" cy="100" r="3.5" class="node" />
  <circle cx="150" cy="180" r="3.5" class="node" />
  <text x="168" y="145" class="small start">C</text>
  <path d="M234 100 H260 V180 H234" class="wire" />
  <circle cx="260" cy="140" r="4" class="node" />
  <path d="M260 140 H290 V256 H30" class="wire" />
  <text x="30" y="248" class="lbl start">neutro</text>
  <text x="202" y="82" class="small">enrolamento 1</text>
  <text x="202" y="200" class="small">enrolamento 2</text>
  <text x="160" y="290" class="note">a fase no 1 gira para um lado; no 2, para o outro</text>

  <g transform="translate(340 0)">
    <text x="160" y="22" class="title">4 fios, principal e auxiliar</text>
    <text x="160" y="40" class="sub">(bomba, máquina de bancada)</text>
    <path d="M30 80 H250 V116" class="wire" />
    <text x="30" y="72" class="lbl start">fase</text>
    <path d={vbumps(250, 116)} class="coil" />
    <path d="M250 180 V250" class="wire" />
    <text x="270" y="152" class="small start">principal</text>
    <path d="M30 250 H290" class="wire" />
    <text x="30" y="242" class="lbl start">neutro</text>
    <circle cx="100" cy="80" r="3.5" class="node" />
    <circle cx="250" cy="250" r="3.5" class="node" />
    <path d="M100 80 V108 M100 120 V136" class="wire" />
    <path d="M88 108 H112 M88 120 H112" class="cap" />
    <text x="82" y="118" class="small end">C</text>
    <circle cx="100" cy="141" r="5" class="term" />
    <circle cx="100" cy="229" r="5" class="term" />
    <path d="M105 141 H170 V153" class="wire" />
    <path d={vbumps(170, 153, 3)} class="coil aux" />
    <path d="M170 201 V229 H105" class="wire" />
    <path d="M100 234 V250" class="wire" />
    <text x="190" y="182" class="small start">auxiliar</text>
    <path d="M132 150 V220" class="swap" marker-start="url(#m08-sw)" marker-end="url(#m08-sw)" />
    <text x="124" y="190" class="small end">trocar</text>
    <text x="160" y="290" class="note">trocar as duas pontas do auxiliar inverte o sentido</text>
  </g>
  <defs>
    <marker id="m08-sw" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="head" />
    </marker>
  </defs>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wire {
    stroke: var(--fg);
    stroke-width: 1.75;
  }
  .switch {
    stroke: var(--accent);
    stroke-width: 3;
  }
  .coil {
    stroke: var(--copper);
    stroke-width: 3;
  }
  .coil.aux {
    stroke: var(--info);
  }
  .cap {
    stroke: var(--fg);
    stroke-width: 3;
  }
  .node {
    fill: var(--fg);
    stroke: none;
  }
  .term {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 1.75;
  }
  .swap {
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-dasharray: 5 4;
  }
  .head {
    fill: var(--accent);
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 13px;
    text-anchor: middle;
  }
  .title {
    font-size: 14px;
    font-weight: 700;
  }
  .sub,
  .small,
  .note {
    fill: var(--fg-muted);
    font-size: 12px;
  }
  .lbl {
    font-weight: 600;
  }
  .start {
    text-anchor: start;
  }
  .end {
    text-anchor: end;
  }
</style>
