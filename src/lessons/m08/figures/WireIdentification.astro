---
/*
 * 08.4: finding the common, the main and the auxiliary winding of a
 * three-wire single-phase motor with an ohmmeter. Inside, the main winding
 * (12 Ω) and the auxiliary (20 Ω) join at the common, C. The three readings
 * between the loose wires: A–B is the largest (both windings in series), so
 * the wire left out, C, is the common; from C, the smaller reading is the
 * main winding.
 */
const bumps = (x: number, y: number, n = 5) => `M${x} ${y}${' a9 9 0 0 1 18 0'.repeat(n)}`;
const readings = [
  { pair: 'A e B', value: '32 Ω', note: 'a maior: os dois em série' },
  { pair: 'A e C', value: '12 Ω', note: 'a menor: enrolamento principal' },
  { pair: 'B e C', value: '20 Ω', note: 'enrolamento auxiliar' },
];
---

<svg viewBox="0 0 660 270" width="660" height="270" class="fig" aria-hidden="true">
  <rect x="20" y="30" width="270" height="200" rx="14" class="motor" />
  <text x="155" y="52" class="title">dentro do motor</text>
  <path d={bumps(70, 110)} class="coil" />
  <path d={bumps(70, 180)} class="coil aux" />
  <text x="115" y="96" class="lbl">principal, 12 Ω</text>
  <text x="115" y="166" class="lbl">auxiliar, 20 Ω</text>
  <path d="M70 110 H50 V180 H70" class="wire" />
  <circle cx="50" cy="145" r="4" class="node" />
  <path d="M50 145 H40 V246 H330" class="wire" />
  <path d="M160 110 H250 V80 H330" class="wire" />
  <path d="M160 180 H250 V160 H330" class="wire" />
  <circle cx="336" cy="80" r="7" class="term" />
  <circle cx="336" cy="160" r="7" class="term" />
  <circle cx="336" cy="246" r="7" class="term" />
  <text x="352" y="85" class="wire-t">A</text>
  <text x="352" y="165" class="wire-t">B</text>
  <text x="352" y="251" class="wire-t">C (comum)</text>

  {
    readings.map((r, i) => (
      <g transform={`translate(430 ${44 + i * 70})`}>
        <rect x="0" y="0" width="214" height="56" rx="8" class="meter" />
        <text x="12" y="22" class="pair">
          entre {r.pair}
        </text>
        <text x="202" y="24" class="value">
          {r.value}
        </text>
        <text x="12" y="44" class="note">
          {r.note}
        </text>
      </g>
    ))
  }
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .motor {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  .coil {
    stroke: var(--copper);
    stroke-width: 3;
  }
  .coil.aux {
    stroke: var(--info);
  }
  .wire {
    stroke: var(--fg);
    stroke-width: 1.75;
  }
  .node {
    fill: var(--fg);
    stroke: none;
  }
  .term {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2;
  }
  .meter {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }
  text {
    stroke: none;
    fill: var(--fg);
    font-size: 13px;
  }
  .title {
    fill: var(--fg-muted);
    font-size: 12px;
    text-anchor: middle;
  }
  .lbl {
    font-size: 12.5px;
    text-anchor: middle;
  }
  .wire-t {
    font-weight: 700;
  }
  .pair {
    font-weight: 700;
  }
  .value {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    text-anchor: end;
  }
  .note {
    fill: var(--fg-muted);
    font-size: 11.5px;
  }
</style>
