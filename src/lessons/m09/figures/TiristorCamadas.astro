---
/* 9.9: the SCR. Left, its four layers P-N-P-N with the anode, the gate on
   the inner P layer and the cathode, next to the symbol. Right, the usual
   way to understand the latch: a PNP and an NPN transistor, each one
   feeding the base of the other. */
const LAYERS = [
  { y: 62, kind: 'p', label: 'P' },
  { y: 100, kind: 'n', label: 'N' },
  { y: 138, kind: 'p', label: 'P' },
  { y: 176, kind: 'n', label: 'N' },
];
const LAYER_H = 38;

/* Arrowhead with its tip at (x2, y2), pointing from (x1, y1). */
const arrow = (x1: number, y1: number, x2: number, y2: number, size = 7) => {
  const len = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / len;
  const uy = (y2 - y1) / len;
  const bx = x2 - ux * size;
  const by = y2 - uy * size;
  const w = size * 0.55;
  return `M${x2} ${y2}L${bx - uy * w} ${by + ux * w}L${bx + uy * w} ${by - ux * w}Z`;
};

const badges = [
  { n: '1', x: 120, y: 214 },
  { n: '2', x: 152, y: 98 },
  { n: '3', x: 95, y: 150 },
];
const notes = [
  { n: '1', y: 72, lines: ['o pulso no G', 'liga o NPN'] },
  { n: '2', y: 126, lines: ['o NPN puxa a base', 'do PNP, que liga'] },
  { n: '3', y: 180, lines: ['o PNP alimenta', 'a base do NPN'] },
];
---

<svg viewBox="0 0 680 280" width="680" height="280" class="fig" aria-hidden="true">
  <text x="165" y="18" class="title">Quatro camadas: P, N, P, N</text>

  <!-- Layers -->
  {
    LAYERS.map((l) => (
      <>
        <rect x="60" y={l.y} width="100" height={LAYER_H} class={l.kind} />
        <text x="110" y={l.y + 25} class="layer">
          {l.label}
        </text>
      </>
    ))
  }
  <path d="M110 50V62M110 214V226M160 157H190" class="lead" />
  <circle cx="110" cy="48" r="4" class="pin" />
  <circle cx="110" cy="228" r="4" class="pin" />
  <circle cx="194" cy="157" r="4" class="pin" />
  <text x="110" y="38" class="label">ânodo (A)</text>
  <text x="110" y="252" class="label">cátodo (K)</text>
  <text x="203" y="154" class="label start">gatilho</text>
  <text x="203" y="170" class="label start">(G)</text>

  <!-- Symbol -->
  <path d="M290 72V105M290 135V200M290 135L308 153H318" class="sym" />
  <path d="M273 105H307L290 135Z" class="sym-fill" />
  <path d="M273 135H307" class="sym" />
  <text x="298" y="82" class="label start">A</text>
  <text x="298" y="198" class="label start">K</text>
  <text x="322" y="157" class="label start">G</text>
  <text x="290" y="252" class="muted">símbolo</text>

  <!-- Two-transistor model -->
  <g transform="translate(340 0)">
    <text x="170" y="18" class="title">Dois transistores que se seguram</text>

    <!-- Q1, PNP: emitter at the anode -->
    <path d="M120 78V118" class="bar" />
    <path d="M120 88L95 68V50M120 108L95 128V178H160M120 98H185V148L160 168" class="sym" />
    <path d={arrow(95, 68, 112.5, 82)} class="sym-fill" />
    <!-- Q2, NPN: emitter at the cathode -->
    <path d="M160 158V198" class="bar" />
    <path d="M160 188L185 208V240M120 178V234H82" class="sym" />
    <path d={arrow(160, 188, 177.5, 202)} class="sym-fill" />

    <circle cx="95" cy="48" r="4" class="pin" />
    <circle cx="185" cy="242" r="4" class="pin" />
    <circle cx="78" cy="234" r="4" class="pin" />
    <text x="95" y="38" class="label">A</text>
    <text x="185" y="264" class="label">K</text>
    <text x="64" y="238" class="label end">G</text>
    <text x="62" y="102" class="muted end">PNP</text>
    <text x="134" y="219" class="muted start">NPN</text>

    {
      badges.map((b) => (
        <>
          <circle cx={b.x} cy={b.y} r="9" class="badge" />
          <text x={b.x} y={b.y + 4} class="badge-text">
            {b.n}
          </text>
        </>
      ))
    }
    {
      notes.map((note) => (
        <>
          <circle cx="218" cy={note.y - 4} r="8" class="badge" />
          <text x="218" y={note.y} class="badge-text">
            {note.n}
          </text>
          {note.lines.map((line, k) => (
            <text x="231" y={note.y + k * 16} class="note">
              {line}
            </text>
          ))}
        </>
      ))
    }
  </g>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    max-width: 100%;
    height: auto;
  }
  .p {
    fill: var(--danger-soft);
    stroke: var(--danger-border);
  }
  .n {
    fill: var(--info-soft);
    stroke: var(--info-border);
  }
  .layer {
    fill: var(--fg);
    font-size: 16px;
    font-weight: 700;
    text-anchor: middle;
  }
  .lead {
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 2.5;
  }
  .pin {
    fill: var(--surface);
    stroke: var(--fg-muted);
    stroke-width: 2;
  }
  .sym {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .bar {
    stroke: var(--fg);
    stroke-width: 4;
  }
  .sym-fill {
    fill: var(--fg);
  }
  .title {
    fill: var(--fg);
    font-size: 15px;
    font-weight: 650;
    text-anchor: middle;
  }
  .label {
    fill: var(--fg);
    font-size: 13px;
    font-weight: 600;
    text-anchor: middle;
  }
  .start {
    text-anchor: start;
  }
  .end {
    text-anchor: end;
  }
  .muted {
    fill: var(--fg-muted);
    font-size: 12px;
    text-anchor: middle;
  }
  .muted.start {
    text-anchor: start;
  }
  .muted.end {
    text-anchor: end;
  }
  .badge {
    fill: var(--accent);
  }
  .badge-text {
    fill: var(--on-accent);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
  }
  .note {
    fill: var(--fg-muted);
    font-size: 12px;
  }
</style>
