---
/* 9.1: the silicon crystal in two dimensions. Each atom shares one electron with each of its four
   neighbours; heat broke one bond, leaving a free electron and a hole. */
const COLS = 4;
const ROWS = 3;
const DX = 118;
const DY = 96;
const X0 = 78;
const Y0 = 64;
const X_END = X0 + (COLS - 1) * DX + DX / 2;
const Y_END = Y0 + (ROWS - 1) * DY + DY / 2;
const atoms = Array.from({ length: COLS * ROWS }, (_, k) => ({
  x: X0 + (k % COLS) * DX,
  y: Y0 + Math.floor(k / COLS) * DY,
}));
/* Bonds between neighbours (and stubs at the edges: the crystal goes on). */
const bonds: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (const a of atoms) {
  bonds.push({ x1: a.x, y1: a.y, x2: Math.min(a.x + DX, X_END), y2: a.y });
  bonds.push({ x1: a.x, y1: a.y, x2: a.x, y2: Math.min(a.y + DY, Y_END) });
  if (a.x === X0) bonds.push({ x1: a.x - DX / 2, y1: a.y, x2: a.x, y2: a.y });
  if (a.y === Y0) bonds.push({ x1: a.x, y1: a.y - DY / 2, x2: a.x, y2: a.y });
}
/* The broken bond: between the second and third atoms of the middle row. */
const broken = { x: X0 + DX * 1.5, y: Y0 + DY };
const isBroken = (b: (typeof bonds)[number]) =>
  b.y1 === broken.y && b.y2 === broken.y && (b.x1 + b.x2) / 2 === broken.x;
const free = { x: broken.x - 4, y: broken.y + 52 };
const LEGEND_Y = Y_END + 32;
---

<svg viewBox="0 0 512 350" width="512" height="350" class="fig" aria-hidden="true">
  <g class="bond">
    {bonds.map((b) => (
      <line x1={b.x1} y1={b.y1} x2={b.x2} y2={b.y2} />
    ))}
  </g>
  <g class="pair">
    {bonds.map((b) => {
      const mx = (b.x1 + b.x2) / 2;
      const my = (b.y1 + b.y2) / 2;
      const horizontal = b.y1 === b.y2;
      const dx = horizontal ? 6 : 0;
      const dy = horizontal ? 0 : 6;
      if (isBroken(b)) return <circle cx={mx - dx} cy={my - dy} r={4.5} />;
      return (
        <>
          <circle cx={mx - dx} cy={my - dy} r={4.5} />
          <circle cx={mx + dx} cy={my + dy} r={4.5} />
        </>
      );
    })}
  </g>

  <g class="atom">
    {atoms.map((a) => (
      <>
        <circle cx={a.x} cy={a.y} r={21} />
        <text x={a.x} y={a.y + 5}>
          Si
        </text>
      </>
    ))}
  </g>

  <!-- The hole left in the broken bond, and the electron that escaped -->
  <circle cx={broken.x + 6} cy={broken.y} r={11} class="halo-hole" />
  <circle cx={broken.x + 6} cy={broken.y} r={5.5} class="hole" />
  <path
    d={`M${broken.x + 4} ${broken.y + 12} Q ${broken.x + 10} ${free.y - 22} ${free.x + 2} ${free.y - 10}`}
    class="trail"
  />
  <circle cx={free.x} cy={free.y} r={11} class="halo-free" />
  <circle cx={free.x} cy={free.y} r={5.5} class="free" />

  <!-- Legend -->
  <g transform={`translate(28 ${LEGEND_Y})`}>
    <circle cx="6" cy="0" r="4.5" class="legend-pair" />
    <circle cx="18" cy="0" r="4.5" class="legend-pair" />
    <text x="30" y="5" class="lbl">
      elétrons presos numa ligação
    </text>
    <circle cx="258" cy="0" r="9" class="halo-free" />
    <circle cx="258" cy="0" r="5" class="free" />
    <text x="273" y="5" class="lbl">
      elétron livre
    </text>
    <circle cx="380" cy="0" r="9" class="halo-hole" />
    <circle cx="380" cy="0" r="5" class="hole" />
    <text x="395" y="5" class="lbl">
      lacuna
    </text>
  </g>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    max-width: 100%;
    height: auto;
  }
  .bond line {
    stroke: var(--border-strong);
    stroke-width: 6;
    stroke-linecap: round;
  }
  .pair circle,
  .legend-pair {
    fill: var(--info);
  }
  .atom circle {
    fill: var(--surface);
    stroke: var(--fg-muted);
    stroke-width: 2;
  }
  .atom text {
    fill: var(--fg);
    font-size: 14px;
    font-weight: 650;
    text-anchor: middle;
  }
  .hole {
    fill: var(--bg);
    stroke: var(--danger);
    stroke-width: 2.5;
  }
  .halo-hole {
    fill: var(--danger-soft);
    stroke: var(--danger-border);
  }
  .free {
    fill: var(--info);
  }
  .halo-free {
    fill: var(--info-soft);
    stroke: var(--info-border);
  }
  .trail {
    fill: none;
    stroke: var(--info);
    stroke-width: 1.8;
    stroke-dasharray: 4 3;
    stroke-linecap: round;
  }
  .lbl {
    fill: var(--fg);
    font-size: 14px;
  }
</style>
