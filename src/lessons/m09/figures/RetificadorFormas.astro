---
/*
 * 9.3: the waveforms of a rectifier, two cycles of the mains: the sine of the
 * secondary, the half-wave output, the full-wave output and the full-wave
 * output with the filter capacitor (ripple exaggerated so it shows).
 */
const X0 = 150;
const X1 = 626;
const ROW = 88;
const TOP = 46;
const AMP = 30;
const CYCLES = 2;
const N = 400;
const ts = Array.from({ length: N + 1 }, (_, k) => (k / N) * CYCLES);
const xOf = (t: number) => X0 + (t / CYCLES) * (X1 - X0);
const sine = (t: number) => Math.sin(2 * Math.PI * t);

/* Filtered full wave: the capacitor follows the rectified sine up to the peak,
   then discharges linearly until the sine catches up again. */
const DROP_PER_CYCLE = 0.36;
function filtered(): number[] {
  let held = 0;
  return ts.map((t, k) => {
    const v = Math.abs(sine(t));
    const dt = k === 0 ? 0 : ts[k]! - ts[k - 1]!;
    held = Math.max(v, held - DROP_PER_CYCLE * 2 * dt);
    return held;
  });
}
const filt = filtered();

const rows = [
  { label: 'Secundário (CA)', sub: '60 ciclos por segundo', v: ts.map(sine) },
  { label: 'Meia onda', sub: '60 pulsos por segundo', v: ts.map((t) => Math.max(0, sine(t))) },
  { label: 'Onda completa', sub: '120 pulsos por segundo', v: ts.map((t) => Math.abs(sine(t))) },
  { label: 'Com filtro', sub: 'quase lisa, com ondulação', v: filt },
];

const path = (v: number[], y0: number) =>
  'M' + v.map((y, k) => `${xOf(ts[k]!).toFixed(1)} ${(y0 - y * AMP).toFixed(1)}`).join('L');

/* Ripple bracket on the last row, at the second valley. */
const lastY = TOP + 3 * ROW;
const valley = Math.min(...filt.slice(Math.floor(N * 0.5), Math.floor(N * 0.75)));
const bx = xOf(1.47);
---

<svg viewBox="0 0 640 380" width="640" height="380" class="fig" aria-hidden="true">
  {
    rows.map((r, i) => {
      const y0 = TOP + i * ROW;
      return (
        <g>
          <text x="12" y={y0 - 4} class="lbl">
            {r.label}
          </text>
          <text x="12" y={y0 + 14} class="sub">
            {r.sub}
          </text>
          <line x1={X0} y1={y0} x2={X1} y2={y0} class="zero" />
          {i === 3 && <path d={path(rows[2]!.v, y0)} class="ghost" />}
          <path d={path(r.v, y0)} class={i === 0 ? 'wave ac' : 'wave'} />
        </g>
      );
    })
  }
  <path
    d={`M${bx - 6} ${lastY - AMP}H${bx + 6}M${bx} ${lastY - AMP}V${lastY - valley * AMP}M${bx - 6} ${lastY - valley * AMP}H${bx + 6}`}
    class="bracket"
  />
  <text x={bx + 10} y={lastY - ((1 + valley) / 2) * AMP + 4} class="sub strong">
    ondulação
  </text>
  <line x1={X0} y1={TOP + 3 * ROW + 26} x2={X1} y2={TOP + 3 * ROW + 26} class="axis" />
  <text x={X1} y={TOP + 3 * ROW + 44} class="sub end">
    tempo → (dois ciclos da rede, 33 ms)
  </text>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    max-width: 100%;
    height: auto;
  }
  .lbl {
    fill: var(--fg);
    font-size: 15px;
    font-weight: 650;
  }
  .sub {
    fill: var(--fg-muted);
    font-size: 12.5px;
  }
  .strong {
    font-weight: 650;
  }
  .end {
    text-anchor: end;
  }
  .zero {
    stroke: var(--border-strong);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .axis {
    stroke: var(--fg-subtle);
    stroke-width: 1;
  }
  .wave {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .ac {
    stroke: var(--copper);
  }
  .ghost {
    fill: none;
    stroke: var(--fg-subtle);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }
  .bracket {
    fill: none;
    stroke: var(--danger);
    stroke-width: 2;
  }
</style>
