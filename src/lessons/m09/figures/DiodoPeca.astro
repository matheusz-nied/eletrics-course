---
/*
 * 9.2: a 1N4007 rectifier diode (DO-41 package) above its schematic symbol,
 * terminal over terminal: the band marks the cathode, the bar of the symbol.
 * Generic drawing, no brand. Fallback of <Part3D part="diode">.
 */
const LEAD_Y = 66;
const SYM_Y = 186;
---

<svg viewBox="0 0 560 266" width="560" height="266" class="fig" aria-hidden="true">
  <!-- The part: leads, black body, silver band on the cathode side -->
  <line x1="36" y1={LEAD_Y} x2="206" y2={LEAD_Y} class="lead" />
  <line x1="354" y1={LEAD_Y} x2="524" y2={LEAD_Y} class="lead" />
  <rect x="200" y={LEAD_Y - 24} width="160" height="48" rx="12" class="body" />
  <rect x="318" y={LEAD_Y - 24} width="18" height="48" class="band" />
  <text x="262" y={LEAD_Y + 5} class="print">
    1N4007
  </text>

  <text x="120" y={LEAD_Y - 18} class="lbl">
    anodo (A)
  </text>
  <text x="440" y={LEAD_Y - 18} class="lbl">
    catodo (K)
  </text>
  <text x="327" y={LEAD_Y + 46} class="note">
    a faixa marca o catodo
  </text>

  <!-- Matching lines between part and symbol -->
  <line x1="120" y1={LEAD_Y + 10} x2="120" y2={SYM_Y - 14} class="match" />
  <line x1="440" y1={LEAD_Y + 10} x2="440" y2={SYM_Y - 14} class="match" />

  <!-- The symbol: triangle pointing to the bar, the way the current goes -->
  <line x1="36" y1={SYM_Y} x2="250" y2={SYM_Y} class="wire" />
  <line x1="310" y1={SYM_Y} x2="524" y2={SYM_Y} class="wire" />
  <path d={`M250 ${SYM_Y - 26}L306 ${SYM_Y}L250 ${SYM_Y + 26}Z`} class="sym" />
  <line x1="308" y1={SYM_Y - 26} x2="308" y2={SYM_Y + 26} class="bar" />
  <text x="120" y={SYM_Y - 12} class="lbl">
    A
  </text>
  <text x="440" y={SYM_Y - 12} class="lbl">
    K
  </text>

  <g class="arrow">
    <line x1="210" y1={SYM_Y + 42} x2="350" y2={SYM_Y + 42} />
    <path d={`M340 ${SYM_Y + 36}L352 ${SYM_Y + 42}L340 ${SYM_Y + 48}`} />
  </g>
  <text x="280" y={SYM_Y + 22 + 42} class="note">
    sentido em que a corrente passa
  </text>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    max-width: 100%;
    height: auto;
  }
  .lead {
    stroke: var(--fg-subtle);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .body {
    fill: var(--fg);
  }
  .band {
    fill: var(--border-strong);
  }
  .print {
    fill: var(--bg);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    text-anchor: middle;
  }
  .lbl {
    fill: var(--fg);
    font-size: 15px;
    font-weight: 650;
    text-anchor: middle;
  }
  .note {
    fill: var(--fg-muted);
    font-size: 13px;
    text-anchor: middle;
  }
  .match {
    stroke: var(--fg-subtle);
    stroke-width: 1.5;
    stroke-dasharray: 3 4;
  }
  .wire {
    stroke: var(--fg);
    stroke-width: 2.5;
  }
  .sym {
    fill: var(--fg);
    stroke: var(--fg);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .bar {
    stroke: var(--fg);
    stroke-width: 4;
  }
  .arrow line,
  .arrow path {
    fill: none;
    stroke: var(--success);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
