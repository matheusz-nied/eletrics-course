---
/* 03.3: measuring current in three steps: the circuit as it is, opened between A and B, and closed again through the ammeter. */
const panels = [
  { title: '1. O circuito funcionando', sub: 'a corrente passa pelo fio A–B', state: 'whole' },
  { title: '2. Desligue e abra em A–B', sub: 'sem caminho, nada acende', state: 'open' },
  {
    title: '3. O multímetro fecha a abertura',
    sub: 'a corrente passa por dentro dele',
    state: 'meter',
  },
] as const;
---

<svg viewBox="0 0 690 230" width="690" height="230" class="fig" aria-hidden="true">
  {panels.map((p, i) => (
    <g transform={`translate(${10 + i * 228} 0)`}>
      <text x="105" y="22" class="title">
        {p.title}
      </text>
      <g class="wire">
        <path d="M30 70 V50 H86 M124 50 H180 V90 M180 130 V170 H30 V110" />
        {p.state === 'whole' && <path d="M86 50 H124" />}
      </g>
      <g class="src">
        <path d="M16 74 H44 M22 84 H38 M16 94 H44 M22 104 H38" />
        <path d="M30 70 V74 M30 104 V110" />
      </g>
      <g class={`load${p.state === 'open' ? ' off' : ''}`}>
        <circle cx="180" cy="110" r="18" />
        <path d="M168 98 L192 122 M192 98 L168 122" />
      </g>
      <circle cx="86" cy="50" r="4" class="node" />
      <circle cx="124" cy="50" r="4" class="node" />
      <text x="80" y="40" class="pt">
        A
      </text>
      <text x="130" y="40" class="pt">
        B
      </text>
      {p.state === 'meter' && (
        <>
          <path d="M86 50 V82 H90 M120 82 H124 V50" class="meter-wire" />
          <g class="meter">
            <circle cx="105" cy="82" r="15" />
            <text x="105" y="87" class="m">
              A
            </text>
          </g>
          <text x="105" y="122" class="note">
            borne mA ou 10A
          </text>
        </>
      )}
      {p.state === 'open' && (
        <text x="105" y="78" class="cut">
          aberto
        </text>
      )}
      <text x="105" y="200" class="sub">
        {p.sub}
      </text>
    </g>
  ))}
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wire {
    stroke: var(--copper);
  }
  .meter-wire {
    stroke: var(--accent);
    stroke-dasharray: 5 4;
  }
  .src {
    stroke: var(--fg);
  }
  .load {
    stroke: var(--danger);
  }
  .load circle {
    fill: var(--warning-soft);
  }
  .load.off {
    stroke: var(--fg-subtle);
  }
  .load.off circle {
    fill: none;
  }
  .node {
    fill: var(--fg);
    stroke: none;
  }
  .meter {
    stroke: var(--accent);
  }
  .meter circle {
    fill: var(--accent-soft);
  }
  text {
    stroke: none;
    text-anchor: middle;
    fill: var(--fg);
    font-size: 13px;
  }
  .title {
    font-size: 14px;
    font-weight: 700;
  }
  .pt {
    font-weight: 700;
  }
  .m {
    fill: var(--accent);
    font-weight: 700;
    font-size: 14px;
  }
  .note {
    fill: var(--accent);
    font-size: 12px;
    font-weight: 600;
  }
  .sub {
    fill: var(--fg-muted);
    font-size: 12.5px;
  }
  .cut {
    fill: var(--fg-subtle);
    font-size: 12px;
  }
</style>
