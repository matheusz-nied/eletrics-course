---
/* 03.1: the multimeter as voltmeter (parallel, 10 MΩ), ammeter (series, small shunt) and ohmmeter (own current, circuit off). */
---

<svg viewBox="0 0 690 270" width="690" height="270" class="fig" aria-hidden="true">
  <!-- Voltmeter -->
  <g transform="translate(10 0)">
    <text x="105" y="22" class="title">
      Voltímetro: em paralelo
    </text>
    <g class="wire">
      <path d="M30 70 V50 H180 V90 M180 130 V170 H30 V110" />
      <path d="M180 60 H210 V95 M210 125 V160 H180" class="meter-wire" />
    </g>
    <g class="src">
      <path d="M16 74 H44 M22 84 H38 M16 94 H44 M22 104 H38" />
      <path d="M30 70 V74 M30 104 V110" />
    </g>
    <g class="load">
      <circle cx="180" cy="110" r="18" />
      <path d="M168 98 L192 122 M192 98 L168 122" />
    </g>
    <g class="meter">
      <circle cx="210" cy="110" r="15" />
      <text x="210" y="115" class="m">
        V
      </text>
    </g>
    <text x="105" y="204" class="note">
      por dentro: cerca de 10 MΩ
    </text>
    <text x="105" y="222" class="sub">
      desvia uma corrente mínima
    </text>
    <text x="105" y="240" class="sub">
      e quase não muda o circuito
    </text>
  </g>

  <!-- Ammeter -->
  <g transform="translate(240 0)">
    <text x="105" y="22" class="title">
      Amperímetro: em série
    </text>
    <g class="wire">
      <path d="M30 70 V50 H86 M124 50 H180 V90 M180 130 V170 H30 V110" />
    </g>
    <g class="src">
      <path d="M16 74 H44 M22 84 H38 M16 94 H44 M22 104 H38" />
      <path d="M30 70 V74 M30 104 V110" />
    </g>
    <g class="load">
      <circle cx="180" cy="110" r="18" />
      <path d="M168 98 L192 122 M192 98 L168 122" />
    </g>
    <g class="meter">
      <circle cx="105" cy="50" r="15" />
      <text x="105" y="55" class="m">
        A
      </text>
    </g>
    <text x="105" y="84" class="cut">
      o fio foi aberto aqui
    </text>
    <text x="105" y="204" class="note">
      por dentro: 0,01 Ω a alguns ohms
    </text>
    <text x="105" y="222" class="sub">
      a corrente inteira passa por ele;
    </text>
    <text x="105" y="240" class="sub">
      em paralelo, vira um curto
    </text>
  </g>

  <!-- Ohmmeter -->
  <g transform="translate(470 0)">
    <text x="105" y="22" class="title">
      Ohmímetro: circuito desligado
    </text>
    <g class="wire">
      <path d="M70 60 H140 V90 M140 130 V160 H70" class="meter-wire" />
    </g>
    <g class="res">
      <rect x="130" y="90" width="20" height="40" rx="2" />
    </g>
    <text x="160" y="115" class="val start">
      R = ?
    </text>
    <g class="meter">
      <circle cx="70" cy="110" r="15" />
      <text x="70" y="115" class="m">
        Ω
      </text>
      <path d="M70 60 V95 M70 125 V160" />
    </g>
    <text x="105" y="204" class="note">
      por dentro: fonte de corrente
    </text>
    <text x="105" y="222" class="sub">
      injeta uma corrente conhecida
    </text>
    <text x="105" y="240" class="sub">
      e calcula R = V ÷ I
    </text>
  </g>
</svg>

<style>
  .fig {
    font-family: var(--font-sans);
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wire {
    stroke: var(--copper);
  }
  .meter-wire {
    stroke: var(--accent);
    stroke-dasharray: 5 4;
  }
  .src {
    stroke: var(--fg);
  }
  .load {
    stroke: var(--danger);
  }
  .res {
    stroke: var(--fg);
  }
  .res rect {
    fill: var(--surface);
  }
  .meter {
    stroke: var(--accent);
  }
  .meter circle {
    fill: var(--accent-soft);
  }
  text {
    stroke: none;
    text-anchor: middle;
    fill: var(--fg);
    font-size: 13px;
  }
  .title {
    font-size: 14px;
    font-weight: 700;
  }
  .m {
    fill: var(--accent);
    font-weight: 700;
    font-size: 14px;
  }
  .note {
    font-weight: 600;
    fill: var(--accent);
  }
  .sub {
    fill: var(--fg-muted);
    font-size: 12.5px;
  }
  .cut {
    fill: var(--fg-subtle);
    font-size: 11.5px;
  }
  .val {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .start {
    text-anchor: start;
  }
</style>
