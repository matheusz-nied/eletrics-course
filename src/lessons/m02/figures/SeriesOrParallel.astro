---
/* 02.4: how to recognize series, parallel, and the classic trap (a branch leaving the middle point). */
---

<div class="panels">
  <!-- Série -->
  <svg viewBox="0 0 240 230" class="fig" aria-hidden="true">
    <g transform="translate(10 0)">
      <path class="wire" d="M10 70 H50 M90 70 H130 M130 70 H150 M190 70 H220" />
      <rect class="res" x="50" y="62" width="40" height="16" rx="2" />
      <rect class="res" x="150" y="62" width="40" height="16" rx="2" />
      <circle class="term" cx="10" cy="70" r="4" />
      <circle class="term" cx="220" cy="70" r="4" />
      <circle class="mid" cx="120" cy="70" r="3" />
      <text x="70" y="52" class="name">
        Ra
      </text>
      <text x="170" y="52" class="name">
        Rb
      </text>
      <text x="70" y="100" class="cur">
        I →
      </text>
      <text x="170" y="100" class="cur">
        I →
      </text>
      <text x="115" y="150" class="title">
        Série
      </text>
      <text x="115" y="172" class="sub">
        um caminho só, sem desvio
      </text>
      <text x="115" y="190" class="sub">
        mesma corrente nos dois
      </text>
      <text x="115" y="214" class="formula">
        Req = Ra + Rb
      </text>
    </g>
  </svg>

  <!-- Paralelo -->
  <svg viewBox="0 0 240 230" class="fig" aria-hidden="true">
    <g transform="translate(20 0)">
      <path
        class="wire"
        d="M10 70 H40 M40 40 V100 M40 40 H80 M120 40 H160 M40 100 H80 M120 100 H160 M160 40 V100 M160 70 H190"
      />
      <rect class="res" x="80" y="32" width="40" height="16" rx="2" />
      <rect class="res" x="80" y="92" width="40" height="16" rx="2" />
      <circle class="term" cx="10" cy="70" r="4" />
      <circle class="term" cx="190" cy="70" r="4" />
      <circle class="nodeA" cx="40" cy="70" r="6" />
      <circle class="nodeB" cx="160" cy="70" r="6" />
      <text x="28" y="66" class="lab labA end">
        A
      </text>
      <text x="172" y="66" class="lab labB start">
        B
      </text>
      <text x="100" y="24" class="name">
        Ra
      </text>
      <text x="100" y="128" class="name">
        Rb
      </text>
      <text x="100" y="150" class="title">
        Paralelo
      </text>
      <text x="100" y="172" class="sub">
        ligados aos mesmos dois nós
      </text>
      <text x="100" y="190" class="sub">
        mesma tensão nos dois
      </text>
      <text x="100" y="214" class="formula">
        Req = Ra·Rb ÷ (Ra + Rb)
      </text>
    </g>
  </svg>

  <!-- Pegadinha -->
  <svg viewBox="0 0 240 230" class="fig" aria-hidden="true">
    <g transform="translate(5 0)">
      <path class="wire" d="M10 70 H40 M80 70 H140 M180 70 H220 M110 70 V82 M110 118 V130 H10" />
      <rect class="res" x="40" y="62" width="40" height="16" rx="2" />
      <rect class="res" x="140" y="62" width="40" height="16" rx="2" />
      <rect class="res warn" x="102" y="82" width="16" height="36" rx="2" />
      <circle class="term" cx="10" cy="70" r="4" />
      <circle class="term" cx="220" cy="70" r="4" />
      <circle class="term" cx="10" cy="130" r="4" />
      <circle class="split" cx="110" cy="70" r="5" />
      <text x="60" y="52" class="name">
        Ra
      </text>
      <text x="160" y="52" class="name">
        Rb
      </text>
      <text x="124" y="104" class="name start">
        Rc
      </text>
      <text x="115" y="150" class="title warn-t">
        Cuidado
      </text>
      <text x="115" y="172" class="sub">
        Ra e Rb parecem em série,
      </text>
      <text x="115" y="190" class="sub">
        mas a corrente se divide no meio
      </text>
      <text x="115" y="214" class="formula">
        não some Ra + Rb direto
      </text>
    </g>
  </svg>
</div>

<style>
  .panels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0;
    width: 100%;
  }
  .fig {
    flex: 1 1 13rem;
    max-width: 15rem;
    height: auto;
    font-family: var(--font-sans);
  }
  .wire {
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .res {
    fill: var(--bg);
    stroke: var(--copper);
    stroke-width: 2.5;
  }
  .res.warn {
    stroke: var(--warning);
    fill: var(--warning-soft);
  }
  .term {
    fill: var(--bg);
    stroke: var(--fg-muted);
    stroke-width: 2;
  }
  .mid {
    fill: var(--fg-subtle);
  }
  .nodeA {
    fill: var(--accent);
  }
  .nodeB {
    fill: var(--success);
  }
  .split {
    fill: var(--warning);
  }
  text {
    fill: var(--fg);
    font-size: 14px;
    text-anchor: middle;
  }
  .name {
    font-weight: 600;
    font-size: 13px;
  }
  .start {
    text-anchor: start;
  }
  .end {
    text-anchor: end;
  }
  .lab {
    font-weight: 700;
  }
  .labA {
    fill: var(--accent);
  }
  .labB {
    fill: var(--success);
  }
  .cur {
    fill: var(--copper);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .title {
    font-weight: 700;
    font-size: 15px;
  }
  .warn-t {
    fill: var(--warning);
  }
  .sub {
    fill: var(--fg-muted);
    font-size: 13px;
  }
  .formula {
    fill: var(--accent);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
</style>
